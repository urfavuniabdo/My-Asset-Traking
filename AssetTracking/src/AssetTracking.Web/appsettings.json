{
  "//_Features": "مفاتيح تشغيل الوحدات — حوّل أي مفتاح إلى true لإظهار الوحدة في التحديث القادم. الكود وقاعدة البيانات كاملان ولم يُحذف منهما شيء.",
  "Features": {
    "Tickets": true,
    "PreventiveMaintenance": false,
    "Financials": true,
    "ScheduledJobs": false,
    "InventoryAudits": true,
    "Reports": true
  },

  "DatabaseProvider": "SqlServer",
  "//_Seed": "SeedDemoData=true يزرع بيانات تجريبية كاملة. على السيرفر (Render) اضبطها false لوضع نظيف: يوزرات وشركات فقط بلا أصول ولا تذاكر.",
  "SeedDemoData": true,
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AssetTrackingDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
