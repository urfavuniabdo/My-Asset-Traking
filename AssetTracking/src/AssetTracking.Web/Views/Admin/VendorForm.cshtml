@model VendorFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "مورّد جديد" : $"تعديل {Model.NameAr}";
    var action = Model.IsNew ? "CreateVendor" : "EditVendor";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">الإدارة</a></li>
                <li class="breadcrumb-item"><a asp-action="Vendors">المورّدون</a></li>
                <li class="breadcrumb-item active">@(Model.IsNew ? "إضافة" : "تعديل")</li>
            </ol>
        </nav>
        <h1>
            <i class="bi @(Model.IsNew ? "bi-plus-square" : "bi-pencil-square")"></i>
            @(Model.IsNew ? "إضافة مورّد جديد" : "تعديل بيانات المورّد")
        </h1>
    </div>
</div>

<form method="post" asp-action="@action">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-truck"></i> بيانات المورّد</div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (Model.NeedsCompanyPick)
                        {
                            <div class="col-12">
                                <label asp-for="CompanyId" class="form-label">الشركة <span class="text-danger">*</span></label>
                                <select asp-for="CompanyId" class="form-select">
                                    <option value="">— اختر الشركة —</option>
                                    @foreach (var c in Model.Companies)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="CompanyId" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-12 col-md-6">
                            <label asp-for="NameAr" class="form-label">اسم المورّد (عربي) <span class="text-danger">*</span></label>
                            <input asp-for="NameAr" class="form-control" placeholder="مثال: شركة الأهرام لتكنولوجيا المعلومات" />
                            <span asp-validation-for="NameAr" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="NameEn" class="form-label">الاسم بالإنجليزية</label>
                            <input asp-for="NameEn" class="form-control" dir="ltr" />
                            <span asp-validation-for="NameEn" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Code" class="form-label">الكود</label>
                            <input asp-for="Code" class="form-control mono" dir="ltr" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="TaxNumber" class="form-label">الرقم الضريبي</label>
                            <input asp-for="TaxNumber" class="form-control mono" dir="ltr" />
                            <span asp-validation-for="TaxNumber" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-telephone"></i> جهة الاتصال</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="ContactPerson" class="form-label">الشخص المسؤول</label>
                            <input asp-for="ContactPerson" class="form-control" />
                            <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Phone" class="form-label">الهاتف</label>
                            <input asp-for="Phone" class="form-control mono" dir="ltr" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                            <input asp-for="Email" class="form-control mono" type="email" dir="ltr" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Address" class="form-label">العنوان</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label">ملاحظات</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="شروط التعاقد، مدة الضمان، ملاحظات على الأداء…"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-star"></i> التقييم</div>
                <div class="card-body">
                    <label asp-for="Rating" class="form-label">تقييم المورّد (1 — 5)</label>
                    <select asp-for="Rating" class="form-select">
                        <option value="">— بدون تقييم —</option>
                        <option value="5">★★★★★ ممتاز</option>
                        <option value="4">★★★★ جيد جداً</option>
                        <option value="3">★★★ جيد</option>
                        <option value="2">★★ مقبول</option>
                        <option value="1">★ ضعيف</option>
                    </select>
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                    <div class="form-text">يساعد في المقارنة عند اختيار مورّد للصيانة.</div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-toggle-on"></i> الحالة</div>
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">المورّد نشط</label>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <button class="btn btn-primary w-100 mb-2">
                        <i class="bi bi-check-lg"></i> @(Model.IsNew ? "إنشاء المورّد" : "حفظ التعديلات")
                    </button>
                    <a class="btn btn-outline-secondary w-100" asp-action="Vendors">
                        <i class="bi bi-x-lg"></i> إلغاء
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
