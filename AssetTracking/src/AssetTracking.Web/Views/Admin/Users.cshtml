@model UserListViewModel
@using AssetTracking.Web.Helpers
@{
    ViewData["Title"] = "المستخدمون";
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Q) || !string.IsNullOrWhiteSpace(Model.Role)
                    || Model.CompanyId.HasValue || Model.Active.HasValue;
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">الإدارة</a></li>
                <li class="breadcrumb-item active">المستخدمون</li>
            </ol>
        </nav>
        <h1><i class="bi bi-people"></i> المستخدمون والصلاحيات</h1>
        <p class="page-sub">
            <span class="num">@Model.TotalCount.ToString("N0")</span> مستخدم
            @if (hasFilter)
            {
                <span class="badge bg-secondary-subtle text-secondary-emphasis">مُفلتَرة</span>
            }
        </p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-primary" asp-action="CreateUser"><i class="bi bi-person-plus"></i> مستخدم جديد</a>
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-right"></i> رجوع</a>
    </div>
</div>

<section class="stat-grid">
    @if (Model.IsAdmin)
    {
        <a class="stat-card" asp-action="Users" asp-route-role="Admin">
            <span class="stat-icon red"><i class="bi bi-shield-lock"></i></span>
            <div class="stat-body">
                <p class="stat-label">مديرو النظام</p>
                <p class="stat-value">@Model.CountAdmin.ToString("N0")</p>
            </div>
        </a>
    }
    <a class="stat-card" asp-action="Users" asp-route-role="CompanyManager">
        <span class="stat-icon purple"><i class="bi bi-person-badge"></i></span>
        <div class="stat-body">
            <p class="stat-label">مديرو الشركات</p>
            <p class="stat-value">@Model.CountManager.ToString("N0")</p>
        </div>
    </a>
    <a class="stat-card" asp-action="Users" asp-route-role="Technician">
        <span class="stat-icon amber"><i class="bi bi-tools"></i></span>
        <div class="stat-body">
            <p class="stat-label">فنيو الدعم</p>
            <p class="stat-value">@Model.CountTechnician.ToString("N0")</p>
        </div>
    </a>
    <a class="stat-card" asp-action="Users" asp-route-role="Employee">
        <span class="stat-icon blue"><i class="bi bi-person"></i></span>
        <div class="stat-body">
            <p class="stat-label">الموظفون</p>
            <p class="stat-value">@Model.CountEmployee.ToString("N0")</p>
        </div>
    </a>
</section>

<form method="get" class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label">بحث</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input name="q" value="@Model.Q" class="form-control"
                       placeholder="الاسم، البريد، الرقم الوظيفي…" />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label">الدور</label>
            <select name="role" class="form-select" data-autosubmit>
                <option value="">كل الأدوار</option>
                @if (Model.IsAdmin)
                {
                    <option value="Admin" selected="@(Model.Role == "Admin")">مدير النظام</option>
                }
                <option value="CompanyManager" selected="@(Model.Role == "CompanyManager")">مدير شركة</option>
                <option value="Technician" selected="@(Model.Role == "Technician")">فني دعم</option>
                <option value="Employee" selected="@(Model.Role == "Employee")">موظف</option>
            </select>
        </div>
        @if (Model.IsAdmin)
        {
            <div class="col-6 col-md-3">
                <label class="form-label">الشركة</label>
                <select name="companyId" class="form-select" data-autosubmit>
                    <option value="">كل الشركات</option>
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id" selected="@(Model.CompanyId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
        }
        <div class="col-6 col-md-2">
            <label class="form-label">الحالة</label>
            <select name="active" class="form-select" data-autosubmit>
                <option value="">الكل</option>
                <option value="true" selected="@(Model.Active == true)">مُفعَّل</option>
                <option value="false" selected="@(Model.Active == false)">معطَّل</option>
            </select>
        </div>
        <div class="col-6 col-md-2 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel"></i> تطبيق</button>
            @if (hasFilter)
            {
                <a class="btn btn-outline-secondary" asp-action="Users" title="إلغاء الفلاتر">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </div>
</form>

<div class="table-wrap">
    @if (Model.Items.Count == 0)
    {
        <div class="table-empty">
            <i class="bi bi-person-x"></i>
            <p>لا يوجد مستخدمون مطابقون.</p>
            <a class="btn btn-sm btn-primary" asp-action="CreateUser">إضافة مستخدم</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>المستخدم</th>
                        <th>الدور</th>
                        @if (Model.IsAdmin) { <th>الشركة</th> }
                        <th>الإدارة</th>
                        <th class="text-center">العهد</th>
                        <th class="text-nowrap">آخر دخول</th>
                        <th>الحالة</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr class="@(u.IsActive ? (u.LockedOut ? "table-warning" : "") : "table-secondary")">
                        <td>
                            <div class="fw-semibold">
                                <a asp-action="EditUser" asp-route-id="@u.Id">@u.FullName</a>
                            </div>
                            <small class="text-muted mono">@u.Email</small>
                            @if (!string.IsNullOrEmpty(u.JobTitle) || !string.IsNullOrEmpty(u.EmployeeNumber))
                            {
                                <div>
                                    <small class="text-muted">
                                        @u.JobTitle
                                        @if (!string.IsNullOrEmpty(u.EmployeeNumber))
                                        {
                                            <span class="mono">· @u.EmployeeNumber</span>
                                        }
                                    </small>
                                </div>
                            }
                        </td>
                        <td>
                            @if (u.Roles.Count == 0)
                            {
                                <small class="text-muted">بدون دور</small>
                            }
                            else
                            {
                                foreach (var r in u.Roles)
                                {
                                    <span class="badge bg-primary-subtle text-primary-emphasis">@r</span>
                                }
                            }
                        </td>
                        @if (Model.IsAdmin)
                        {
                            <td><small class="text-muted">@(u.CompanyName ?? "— (كل الشركات)")</small></td>
                        }
                        <td><small class="text-muted">@(u.DepartmentName ?? "—")</small></td>
                        <td class="text-center">
                            @if (u.AssetsHeld > 0)
                            {
                                <a class="badge bg-info-subtle text-info-emphasis text-decoration-none"
                                   asp-controller="Custody" asp-action="Index">@u.AssetsHeld.ToString("N0")</a>
                            }
                            else
                            {
                                <span class="text-muted">0</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (u.LastLoginAt.HasValue)
                            {
                                <small>@DisplayHelper.Relative(u.LastLoginAt.Value)</small>
                            }
                            else
                            {
                                <small class="text-muted">لم يدخل بعد</small>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis">
                                    <i class="bi bi-check-circle"></i> مُفعَّل
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                    <i class="bi bi-slash-circle"></i> معطَّل
                                </span>
                            }
                            @if (u.LockedOut)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis">
                                    <i class="bi bi-lock"></i> مقفل
                                </span>
                            }
                            @if (u.MustChangePassword)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis" title="مطلوب تغيير كلمة المرور">
                                    <i class="bi bi-key"></i>
                                </span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="EditUser" asp-route-id="@u.Id"
                               title="تعديل"><i class="bi bi-pencil"></i></a>

                            <form method="post" asp-action="ToggleUser" class="d-inline"
                                  onsubmit="return confirm('@(u.IsActive ? "تعطيل" : "تفعيل") حساب «@u.FullName»؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                        title="@(u.IsActive ? "تعطيل الحساب" : "تفعيل الحساب")">
                                    <i class="bi @(u.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                            </form>

                            @if (u.LockedOut)
                            {
                                <form method="post" asp-action="UnlockUser" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="btn btn-sm btn-outline-info" title="فتح القفل">
                                        <i class="bi bi-unlock"></i>
                                    </button>
                                </form>
                            }

                            <button class="btn btn-sm btn-outline-secondary" type="button"
                                    data-bs-toggle="modal" data-bs-target="#pwd-@u.Id"
                                    title="إعادة تعيين كلمة المرور">
                                <i class="bi bi-key"></i>
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" />

@* ── نوافذ إعادة تعيين كلمة المرور ── *@
@foreach (var u in Model.Items)
{
    <div class="modal fade" id="pwd-@u.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-action="ResetPassword" class="modal-content">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@u.Id" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-key"></i> إعادة تعيين كلمة المرور</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">
                        المستخدم: <strong>@u.FullName</strong>
                        <br /><small class="text-muted mono">@u.Email</small>
                    </p>
                    <label class="form-label">كلمة المرور الجديدة <span class="text-danger">*</span></label>
                    <input type="password" name="newPassword" class="form-control" required minlength="8"
                           placeholder="8 أحرف على الأقل" autocomplete="new-password" />
                    <div class="form-text">
                        سيُطلب من المستخدم تغييرها عند أول تسجيل دخول.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button class="btn btn-primary"><i class="bi bi-check-lg"></i> تعيين</button>
                </div>
            </form>
        </div>
    </div>
}
