@model ProductionLineFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "خط إنتاج جديد" : $"تعديل {Model.NameAr}";
    var action = Model.IsNew ? "CreateProductionLine" : "EditProductionLine";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">الإدارة</a></li>
                <li class="breadcrumb-item"><a asp-action="ProductionLines">خطوط الإنتاج</a></li>
                <li class="breadcrumb-item active">@(Model.IsNew ? "إضافة" : "تعديل")</li>
            </ol>
        </nav>
        <h1>
            <i class="bi @(Model.IsNew ? "bi-plus-square" : "bi-pencil-square")"></i>
            @(Model.IsNew ? "إضافة خط إنتاج" : "تعديل بيانات خط الإنتاج")
        </h1>
        <p class="text-muted small mb-0">
            خط الإنتاج مفهوم تشغيلي مستقل: ليس فرعًا من فروع الشركة ولا مخزنًا، ولا يظهر في أيٍّ من قائمتيهما.
        </p>
    </div>
</div>

<form method="post" asp-action="@action">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-diagram-3"></i> بيانات الخط</div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (Model.NeedsCompanyPick)
                        {
                            <div class="col-12">
                                <label asp-for="CompanyId" class="form-label">الشركة <span class="text-danger">*</span></label>
                                <select asp-for="CompanyId" class="form-select">
                                    <option value="">— اختر الشركة —</option>
                                    @foreach (var c in Model.Companies)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="CompanyId" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-12 col-md-6">
                            <label asp-for="NameAr" class="form-label">اسم خط الإنتاج (عربي) <span class="text-danger">*</span></label>
                            <input asp-for="NameAr" class="form-control" placeholder="مثال: Line 1 — التجميع" />
                            <span asp-validation-for="NameAr" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="NameEn" class="form-label">الاسم بالإنجليزية</label>
                            <input asp-for="NameEn" class="form-control" dir="ltr" />
                            <span asp-validation-for="NameEn" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Code" class="form-label">كود الخط</label>
                            <input asp-for="Code" class="form-control mono" dir="ltr" placeholder="LINE-1" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                            <div class="form-text">لا يتكرر داخل الشركة نفسها.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label">وصف الخط</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="مثال: مسؤول الخط — 01xxxxxxxxx"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-toggle-on"></i> الحالة</div>
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">الخط مُفعَّل</label>
                    </div>
                    <div class="form-text">
                        الخط الموقوف لا يظهر في قوائم إضافة الأصل ولا في فتح تذكرة توقف، ويبقى سجل ماكيناته محفوظًا.
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <button class="btn btn-primary w-100 mb-2">
                        <i class="bi bi-check-lg"></i> @(Model.IsNew ? "إنشاء الخط" : "حفظ التعديلات")
                    </button>
                    <a class="btn btn-outline-secondary w-100" asp-action="ProductionLines">
                        <i class="bi bi-x-lg"></i> إلغاء
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
