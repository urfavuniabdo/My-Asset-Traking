@model RefListViewModel
@{
    ViewData["Title"] = Model.TitleAr;
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Q) || Model.Active.HasValue;

    // خرائط المسارات لكل نوع كيان
    var singular = Model.Kind switch
    {
        "companies" => "Company",
        "departments" => "Department",
        "locations" => "Location",
        "categories" => "Category",
        "vendors" => "Vendor",
        "sla" => "Sla",
        _ => ""
    };
    var addLabel = Model.Kind switch
    {
        "companies" => "شركة جديدة",
        "departments" => "إدارة جديدة",
        "locations" => "موقع جديد",
        "categories" => "تصنيف جديد",
        "vendors" => "مورّد جديد",
        "sla" => "سياسة جديدة",
        _ => "إضافة"
    };
    var nameHeader = Model.Kind switch
    {
        "companies" => "الشركة",
        "departments" => "الإدارة",
        "locations" => "الموقع",
        "categories" => "التصنيف",
        "vendors" => "المورّد",
        "sla" => "السياسة",
        _ => "الاسم"
    };
    var codeHeader = Model.Kind == "sla" ? "الأولوية" : "الكود";
    var showAssets = Model.Kind != "sla";
    var showCompany = Model.IsAdmin && Model.Kind != "companies";

    var createAction = "Create" + singular;
    var editAction = "Edit" + singular;

    var total = Model.Items.Count;
    var activeCount = Model.Items.Count(x => x.IsActive);
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">الإدارة</a></li>
                <li class="breadcrumb-item active">@Model.TitleAr</li>
            </ol>
        </nav>
        <h1><i class="bi @Model.Icon"></i> @Model.TitleAr</h1>
        <p class="page-sub">
            <span class="num">@total.ToString("N0")</span> سجل
            (<span class="num">@activeCount.ToString("N0")</span> نشط)
            @if (hasFilter)
            {
                <span class="badge bg-secondary-subtle text-secondary-emphasis">مُفلتَرة</span>
            }
        </p>
    </div>
    <div class="page-head-actions">
        @if (Model.CanCreate)
        {
            <a class="btn btn-primary" asp-action="@createAction">
                <i class="bi bi-plus-lg"></i> @addLabel
            </a>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="bi bi-arrow-right"></i> رجوع للإدارة
        </a>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label">بحث</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input name="q" value="@Model.Q" class="form-control" placeholder="الاسم أو الكود…" />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label">الحالة</label>
            <select name="active" class="form-select" data-autosubmit>
                <option value="">الكل</option>
                <option value="true" selected="@(Model.Active == true)">نشط فقط</option>
                <option value="false" selected="@(Model.Active == false)">غير نشط فقط</option>
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel"></i> تطبيق</button>
            @if (hasFilter)
            {
                <a class="btn btn-outline-secondary" href="@ViewContext.HttpContext.Request.Path"
                   title="إلغاء الفلاتر"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
</form>

<div class="table-wrap">
    @if (Model.Items.Count == 0)
    {
        <div class="table-empty">
            <i class="bi bi-inbox"></i>
            <p>لا توجد سجلات مطابقة.</p>
            @if (Model.CanCreate)
            {
                <a class="btn btn-sm btn-primary" asp-action="@createAction">@addLabel</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@nameHeader</th>
                        <th>@codeHeader</th>
                        @if (showCompany) { <th>الشركة</th> }
                        @if (!string.IsNullOrEmpty(Model.ExtraHeader)) { <th>@Model.ExtraHeader</th> }
                        @if (!string.IsNullOrEmpty(Model.Extra2Header)) { <th>@Model.Extra2Header</th> }
                        @if (showAssets) { <th class="text-center">الأصول</th> }
                        <th>الحالة</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr class="@(r.IsActive ? "" : "table-secondary")">
                        <td>
                            <div class="fw-semibold">
                                <a asp-action="@editAction" asp-route-id="@r.Id">@r.NameAr</a>
                            </div>
                            @if (!string.IsNullOrEmpty(r.NameEn))
                            {
                                <small class="text-muted">@r.NameEn</small>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.Code))
                            {
                                <span class="@(Model.Kind == "sla" ? "" : "mono")">@r.Code</span>
                            }
                            else { <small class="text-muted">—</small> }
                        </td>
                        @if (showCompany)
                        {
                            <td><small class="text-muted">@(r.CompanyName ?? "—")</small></td>
                        }
                        @if (!string.IsNullOrEmpty(Model.ExtraHeader))
                        {
                            <td>
                                @if (!string.IsNullOrEmpty(r.Extra)) { @r.Extra }
                                else { <small class="text-muted">—</small> }
                            </td>
                        }
                        @if (!string.IsNullOrEmpty(Model.Extra2Header))
                        {
                            <td>
                                @if (!string.IsNullOrEmpty(r.Extra2))
                                {
                                    <small class="text-muted">@r.Extra2</small>
                                }
                                else { <small class="text-muted">—</small> }
                            </td>
                        }
                        @if (showAssets)
                        {
                            <td class="text-center">
                                @if (r.AssetsCount > 0)
                                {
                                    <a class="badge bg-primary-subtle text-primary-emphasis text-decoration-none"
                                       asp-controller="Assets" asp-action="Index">@r.AssetsCount.ToString("N0")</a>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                        }
                        <td>
                            @if (r.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis">
                                    <i class="bi bi-check-circle"></i> نشط
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                    <i class="bi bi-slash-circle"></i> معطَّل
                                </span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="@editAction" asp-route-id="@r.Id"
                               title="تعديل"><i class="bi bi-pencil"></i></a>

                            <form method="post" asp-action="ToggleRef" class="d-inline"
                                  onsubmit="return confirm('@(r.IsActive ? "تعطيل" : "تفعيل") السجل «@r.NameAr»؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="kind" value="@Model.Kind" />
                                <input type="hidden" name="id" value="@r.Id" />
                                <button class="btn btn-sm @(r.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                        title="@(r.IsActive ? "تعطيل" : "تفعيل")">
                                    <i class="bi @(r.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<aside class="alert alert-light border mt-3" role="note">
    <i class="bi bi-info-circle"></i>
    السجلات المعطَّلة لا تظهر في قوائم الاختيار عند إضافة أصل أو تذكرة جديدة،
    لكنها تبقى محفوظة للحفاظ على سلامة السجلات التاريخية — لا يوجد حذف نهائي.
</aside>
