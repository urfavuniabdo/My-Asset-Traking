@model AuditLogViewModel
@using AssetTracking.Web.Helpers
@{
    ViewData["Title"] = "سجل التدقيق";
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Q) || !string.IsNullOrWhiteSpace(Model.Action)
                    || !string.IsNullOrWhiteSpace(Model.EntityName)
                    || Model.From.HasValue || Model.To.HasValue;

    string ActionAr(string a) => a switch
    {
        "Create" => "إنشاء",
        "Update" => "تعديل",
        "Delete" => "حذف",
        "Login" => "تسجيل دخول",
        "Logout" => "خروج",
        "ToggleRef" => "تفعيل/تعطيل",
        "ToggleUser" => "تفعيل/تعطيل مستخدم",
        "UnlockUser" => "فتح قفل",
        "ResetPassword" => "إعادة كلمة مرور",
        "CreateUser" => "إنشاء مستخدم",
        "UpdateUser" => "تعديل مستخدم",
        "Assign" => "تسليم عهدة",
        "Return" => "استرجاع عهدة",
        "Transfer" => "نقل",
        "Dispose" => "تخريد",
        "ChangeStatus" => "تغيير الحالة",
        "Close" => "إغلاق تذكرة",
        "Resolve" => "حل تذكرة",
        "CustodyAccept" => "قبول عهدة",
        "CustodyReject" => "رفض عهدة",
        "StartAudit" => "بدء جرد",
        "CompleteAudit" => "إتمام جرد",
        "CancelAudit" => "إلغاء جرد",
        "ToggleSchedule" => "تفعيل/تعطيل خطة صيانة",
        "GenerateTicket" => "توليد تذكرة صيانة",
        "CreateCategory" => "إنشاء تصنيف",
        "EditCategory" => "تعديل تصنيف",
        "CreateSla" => "إنشاء سياسة SLA",
        "EditSla" => "تعديل سياسة SLA",
        "CreateCompany" => "إنشاء شركة",
        "EditCompany" => "تعديل شركة",
        "CreateDepartment" => "إنشاء إدارة",
        "EditDepartment" => "تعديل إدارة",
        "CreateLocation" => "إنشاء موقع",
        "EditLocation" => "تعديل موقع",
        "CreateVendor" => "إنشاء مورّد",
        "EditVendor" => "تعديل مورّد",
        _ => a
    };

    // أسماء الكيانات بالعربية
    string EntityAr(string e) => e switch
    {
        "ApplicationUser" => "مستخدم",
        "Asset" => "أصل",
        "MaintenanceTicket" => "تذكرة صيانة",
        "MaintenanceSchedule" => "خطة صيانة",
        "InventoryAudit" => "جرد",
        "CustodyLog" => "سجل عهدة",
        "Category" or "categories" => "تصنيف",
        "SlaPolicy" or "sla" => "سياسة SLA",
        "Company" or "companies" => "شركة",
        "Department" or "departments" => "إدارة",
        "Location" or "locations" => "موقع",
        "Vendor" or "vendors" => "مورّد",
        _ => e
    };

    // أسماء الحقول بالعربية داخل عمود التغيير
    string FieldAr(string k) => k switch
    {
        "Status" => "الحالة", "Resolution" => "الحل", "TotalCost" => "التكلفة الإجمالية",
        "Code" => "الكود", "Title" => "العنوان", "TotalExpected" => "المتوقع",
        "TotalScanned" => "الممسوح", "TotalMissing" => "المفقود", "ScheduledDate" => "التاريخ المجدول",
        "TechnicianId" => "الفني", "TicketNumber" => "رقم التذكرة", "NextDueDate" => "الاستحقاق التالي",
        "active" => "مُفعَّل", "accept" => "قبول", "note" => "ملاحظة", "Priority" => "الأولوية",
        "NameAr" => "الاسم", "IsActive" => "مُفعَّل",
        _ => k
    };

    // تحويل حِمل JSON إلى نص عربي مقروء "الحقل: القيمة · الحقل: القيمة"
    string Pretty(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        raw = raw.Trim();
        if (!raw.StartsWith("{")) return raw;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object) return raw;
            var parts = new List<string>();
            foreach (var p in doc.RootElement.EnumerateObject())
            {
                var v = p.Value.ValueKind switch
                {
                    System.Text.Json.JsonValueKind.String => p.Value.GetString() ?? "",
                    System.Text.Json.JsonValueKind.True => "نعم",
                    System.Text.Json.JsonValueKind.False => "لا",
                    System.Text.Json.JsonValueKind.Null => "—",
                    _ => p.Value.ToString()
                };
                if (v.Length > 90) v = v.Substring(0, 90) + "…";
                parts.Add($"{FieldAr(p.Name)}: {v}");
            }
            return parts.Count == 0 ? "—" : string.Join(" · ", parts);
        }
        catch { return raw; }
    }

    string ActionCls(string a) => a switch
    {
        "Create" or "CreateUser" => "bg-success-subtle text-success-emphasis",
        "Update" or "UpdateUser" => "bg-primary-subtle text-primary-emphasis",
        "Delete" or "Dispose" => "bg-danger-subtle text-danger-emphasis",
        "ResetPassword" or "UnlockUser" => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">الإدارة</a></li>
                <li class="breadcrumb-item active">سجل التدقيق</li>
            </ol>
        </nav>
        <h1><i class="bi bi-clock-history"></i> سجل التدقيق</h1>
        <p class="page-sub">
            <span class="num">@Model.TotalCount.ToString("N0")</span> عملية مسجَّلة
            @if (hasFilter)
            {
                <span class="badge bg-secondary-subtle text-secondary-emphasis">مُفلتَرة</span>
            }
        </p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-right"></i> رجوع للإدارة</a>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-3">
            <label class="form-label">بحث</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input name="q" value="@Model.Q" class="form-control" placeholder="المستخدم، الكيان، المعرّف…" />
            </div>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">نوع العملية</label>
            <select name="act" class="form-select" data-autosubmit>
                <option value="">الكل</option>
                @foreach (var a in Model.Actions)
                {
                    <option value="@a" selected="@(Model.Action == a)">@ActionAr(a)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">الكيان</label>
            <select name="entityName" class="form-select" data-autosubmit>
                <option value="">الكل</option>
                @foreach (var e in Model.Entities)
                {
                    <option value="@e" selected="@(Model.EntityName == e)">@EntityAr(e)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">من تاريخ</label>
            <input name="from" type="date" class="form-control"
                   value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">إلى تاريخ</label>
            <input name="to" type="date" class="form-control"
                   value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-12 col-md-1 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel"></i></button>
            @if (hasFilter)
            {
                <a class="btn btn-outline-secondary" asp-action="AuditLog" title="إلغاء الفلاتر">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </div>
</form>

<div class="table-wrap">
    @if (Model.Items.Count == 0)
    {
        <div class="table-empty">
            <i class="bi bi-journal-x"></i>
            <p>لا توجد عمليات مطابقة في السجل.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-nowrap">التاريخ والوقت</th>
                        <th>المستخدم</th>
                        <th>العملية</th>
                        <th>الكيان</th>
                        <th>التغيير</th>
                        <th class="text-nowrap">عنوان IP</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap">
                            <div class="mono">@DisplayHelper.DateTimeFull(a.OccurredAt)</div>
                            <small class="text-muted">@DisplayHelper.Relative(a.OccurredAt)</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(a.UserName))
                            {
                                <span class="fw-semibold">@a.UserName</span>
                            }
                            else
                            {
                                <small class="text-muted">النظام</small>
                            }
                        </td>
                        <td>
                            <span class="badge @ActionCls(a.Action)">@ActionAr(a.Action)</span>
                        </td>
                        <td>
                            <div>@EntityAr(a.EntityName)</div>
                            @if (!string.IsNullOrEmpty(a.EntityId))
                            {
                                var shortId = a.EntityId.Length > 12 ? a.EntityId.Substring(0, 8) + "…" : a.EntityId;
                                <small class="text-muted mono" title="@a.EntityId">#@shortId</small>
                            }
                        </td>
                        <td style="max-width:380px">
                            @{
                                var oldTxt = Pretty(a.OldValues);
                                var newTxt = Pretty(a.NewValues);
                            }
                            @if (!string.IsNullOrEmpty(oldTxt) && !string.IsNullOrEmpty(newTxt))
                            {
                                <div class="small">
                                    <span class="text-danger text-decoration-line-through">@oldTxt</span>
                                    <i class="bi bi-arrow-left-short"></i>
                                    <span class="text-success fw-semibold">@newTxt</span>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(newTxt))
                            {
                                <small class="text-success">@newTxt</small>
                            }
                            else if (!string.IsNullOrEmpty(oldTxt))
                            {
                                <small class="text-danger">@oldTxt</small>
                            }
                            else
                            {
                                <small class="text-muted">—</small>
                            }
                        </td>
                        <td class="text-nowrap">
                            <small class="text-muted mono" dir="ltr">@(a.IpAddress ?? "—")</small>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" />

<aside class="alert alert-secondary mt-3" role="note">
    <i class="bi bi-shield-lock"></i>
    سجل التدقيق <strong>غير قابل للتعديل أو الحذف</strong> من داخل النظام — يُكتب فقط بواسطة النظام
    عند كل عملية حساسة، ويُستخدم للمراجعة الداخلية والمساءلة.
</aside>
