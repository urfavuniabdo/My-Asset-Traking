@model WarehousesIndexViewModel
@{
    // لوحة إدارة المخازن الحديثة — المخازن فقط، ومواقع الشركة لها صفحة.
    Layout = null;
    ViewData["Title"] = "إدارة المخازن";
    ViewData["NavActive"] = "warehouses";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
@await Html.PartialAsync("_Head")
<body class="bg-[#e9f1fc] font-sans text-slate-800 antialiased overflow-hidden">
    @await Html.PartialAsync("_ModernBackdrop")

    <div class="h-screen flex flex-col gap-3 p-3 relative z-10">
        @await Html.PartialAsync("_TopBar")

        <div class="flex-1 flex gap-3 min-h-0">
            @await Html.PartialAsync("_SideNav")

            <!-- ══ المحتوى ══ -->
            <main class="flex-1 min-w-0 overflow-y-auto pe-0.5">
                @await Html.PartialAsync("_ToastModern")

                <!-- بار التبويبات — كل تبويب controller مستقل، لا نوع في الرابط -->
                <div class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-1.5 inline-flex gap-1 mb-3">
                    <a href="/Warehouses" class="h-10 px-7 rounded-xl bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] text-white text-[13.5px] font-bold flex items-center shadow-md shadow-blue-200">
                        <i class="fas fa-warehouse text-[12px] me-2"></i> المخازن
                    </a>
                    <a href="/CompanySites" class="h-10 px-7 rounded-xl text-slate-500 hover:bg-blue-50 hover:text-brand-600 text-[13.5px] font-bold flex items-center gap-2 transition">
                        <i class="fas fa-building text-[12px]"></i> مواقع الشركة
                    </a>
                    <a href="/InventoryAudits" class="h-10 px-7 rounded-xl text-slate-500 hover:bg-blue-50 hover:text-brand-600 text-[13.5px] font-bold flex items-center gap-2 transition">
                        <i class="fas fa-clipboard-check text-[12px]"></i> الجرد
                    </a>
                </div>

                <!-- العنوان + الأزرار -->
                <div class="flex items-start justify-between gap-4 mb-3 px-1">
                    <div class="flex items-center gap-3">
                        <span class="w-11 h-11 rounded-xl bg-[#e7f0fe] text-brand-600 flex items-center justify-center"><i class="fas fa-warehouse text-[17px]"></i></span>
                        <div>
                            <h1 class="text-[26px] font-extrabold text-slate-800 leading-tight">إدارة المخازن</h1>
                            <p class="text-[12.5px] text-slate-400 -mt-0.5">المخزن هو «أين يُحفظ الأصل؟» — يعمل وحده، وربطه بفرع الشركة اختياري</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="/CompanySites" class="h-11 px-4 rounded-xl border border-slate-200 bg-white flex items-center gap-2 text-[13px] font-bold text-slate-600 hover:border-brand-300 hover:text-brand-600 transition">
                            <i class="fas fa-building text-[12px] text-brand-500"></i> مواقع الشركة
                        </a>
                        <a href="/Warehouses/Create" class="h-11 px-5 bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] hover:from-[#2f78ef] hover:to-[#1745c9] rounded-xl flex items-center gap-2 text-[13.5px] font-bold text-white shadow-lg shadow-blue-200 transition">
                            <i class="fas fa-plus text-[12px]"></i> إضافة مخزن جديد
                        </a>
                    </div>
                </div>

                <!-- بطاقات الملخص -->
                <div class="grid grid-cols-4 gap-3 mb-3">
                    <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between">
                        <span class="text-right">
                            <span class="block text-[16px] font-extrabold text-slate-800">@Model.Items.Count</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">إجمالي المخازن</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-[#e7f0fe] flex items-center justify-center text-brand-500"><i class="fas fa-warehouse text-[14px]"></i></span>
                    </div>
                    <div class="bg-[#e9f8ef] rounded-2xl p-4 flex items-center justify-between">
                        <span class="text-right">
                            <span class="block text-[16px] font-extrabold text-slate-800">@Model.ActiveCount</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">مخازن نشطة</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-emerald-500"><i class="fas fa-circle-check text-[14px]"></i></span>
                    </div>
                    <div class="bg-[#fdf2e6] rounded-2xl p-4 flex items-center justify-between">
                        <span class="text-right">
                            <span class="block text-[16px] font-extrabold text-slate-800">@Model.TotalAssets</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">أصول داخل المخازن</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-amber-500"><i class="fas fa-cubes text-[14px]"></i></span>
                    </div>
                    <div class="bg-[#fdecec] rounded-2xl p-4 flex items-center justify-between">
                        <span class="text-right">
                            <span class="block text-[16px] font-extrabold text-slate-800">@Model.UnplacedAssets</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">أصول بلا موضع</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-red-400"><i class="fas fa-circle-exclamation text-[14px]"></i></span>
                    </div>
                </div>

                <div class="flex flex-col lg:flex-row gap-3 items-stretch lg:items-start">
                    <!-- جدول المخازن -->
                    <div class="flex-1 min-w-0 bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-2">
                        <div class="hidden md:grid grid-cols-[minmax(170px,1.4fr)_92px_minmax(120px,1fr)_92px_minmax(100px,1fr)_92px_170px] items-center px-4 py-2.5 text-[11.5px] font-bold text-slate-400 border-b border-slate-100">
                            <span>المخزن</span>
                            <span>الكود</span>
                            <span>موقع الشركة</span>
                            <span>الأصول داخله</span>
                            <span>القيمة الإجمالية</span>
                            <span>الحالة</span>
                            <span class="text-left">الإجراءات</span>
                        </div>
                        @if (Model.Items.Count == 0)
                        {
                            <p class="text-center text-[13px] text-slate-400 py-10"><i class="fas fa-warehouse text-[20px] block mb-2 text-slate-300"></i>لا توجد مخازن بعد — أضف أول مخزن من الزر الأعلى</p>
                        }
                        @foreach (var w in Model.Items)
                        {
                            <div class="grid grid-cols-2 md:grid-cols-[minmax(170px,1.4fr)_92px_minmax(120px,1fr)_92px_minmax(100px,1fr)_92px_170px] items-center gap-x-3 gap-y-2 md:gap-x-0 md:gap-y-0 px-3 md:px-4 py-3 md:py-2.5 border-b border-slate-50 last:border-0 hover:bg-blue-50/30 transition">
                                <span class="col-span-2 md:col-span-1 flex items-center gap-2.5 min-w-0">
                                    <span class="w-9 h-9 rounded-lg bg-[#e7f0fe] text-brand-600 flex items-center justify-center shrink-0"><i class="fas fa-warehouse text-[13px]"></i></span>
                                    <span class="min-w-0">
                                        <a href="/Warehouses/Details/@w.Id" class="block text-[13px] font-bold text-slate-800 truncate hover:text-brand-600" data-notranslate>@w.NameAr</a>
                                        @if (!string.IsNullOrEmpty(w.Address))
                                        {
                                            <span class="block text-[10.5px] text-slate-400 truncate" data-notranslate>@w.Address</span>
                                        }
                                    </span>
                                </span>
                                <span class="flex items-center gap-1.5 text-[12px] text-slate-500" dir="ltr"><span class="md:hidden text-[10.5px] font-bold text-slate-400 shrink-0" dir="rtl">كود:</span><span class="truncate">@(string.IsNullOrEmpty(w.Code) ? "—" : w.Code)</span></span>
                                <span class="flex items-center gap-1.5 text-[12px] text-slate-500"><span class="md:hidden text-[10.5px] font-bold text-slate-400 shrink-0">فرع:</span>@if (string.IsNullOrEmpty(w.SiteName))
                                    {
                                        <span class="text-slate-300">— مستقل —</span>
                                    }
                                    else
                                    {
                                        <span class="truncate" data-notranslate>@w.SiteName</span>
                                    }
                                </span>
                                <span class="flex items-center gap-1.5 text-[13px] font-extrabold text-slate-700"><span class="md:hidden text-[10.5px] font-bold text-slate-400">أصول:</span>@w.AssetCount</span>
                                <span class="flex items-center gap-1.5 text-[12px] font-bold text-slate-600"><span class="md:hidden text-[10.5px] font-bold text-slate-400 shrink-0">قيمة:</span>@w.TotalValue.ToString("N0") <span class="text-[10px] text-slate-400">ج.م</span></span>
                                <span>
                                    <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold rounded-full px-2.5 py-1 @(w.IsActive ? "bg-emerald-50 text-emerald-600" : "bg-slate-100 text-slate-400")">
                                        <span class="w-1.5 h-1.5 rounded-full @(w.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                        @(w.IsActive ? "نشط" : "موقوف")
                                    </span>
                                </span>
                                <span class="col-span-2 md:col-span-1 flex items-center justify-start gap-1.5 pt-2 border-t md:border-0 border-slate-100 mt-1 md:mt-0">
                                    <a href="/Warehouses/Details/@w.Id" title="بطاقة المخزن" class="h-7 px-2.5 rounded-lg border border-slate-200 flex items-center gap-1.5 text-[11px] font-bold text-slate-500 hover:text-brand-600 hover:border-brand-300 transition">
                                        <i class="far fa-eye text-[10.5px]"></i> داخله
                                    </a>
                                    <a href="/Assets?warehouseId=@w.Id" title="الأصول في هذا المخزن" class="h-7 px-2.5 rounded-lg border border-slate-200 flex items-center gap-1.5 text-[11px] font-bold text-slate-500 hover:text-brand-600 hover:border-brand-300 transition">
                                        <i class="fas fa-cubes text-[10px]"></i> الأصول
                                    </a>
                                    <a href="/Warehouses/Edit/@w.Id" title="تعديل" class="w-7 h-7 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-pencil text-[10px]"></i></a>
                                </span>
                            </div>
                        }
                    </div>

                    <!-- العمود الجانبي -->
                    <div class="w-full lg:w-[300px] shrink-0 flex flex-col gap-3">
                        <div class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-4">
                            <h3 class="text-[14px] font-extrabold text-slate-800 mb-3"><i class="fas fa-bolt text-brand-500 text-[12px]"></i> إجراءات سريعة</h3>
                            <div class="flex flex-col gap-2">
                                <a href="/Warehouses/Create" class="h-10 rounded-xl border border-brand-200 text-brand-600 hover:bg-blue-50 flex items-center justify-center gap-2 text-[12.5px] font-bold transition"><i class="fas fa-plus text-[11px]"></i> إضافة مخزن</a>
                                <a href="/CompanySites/Create" class="h-10 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 flex items-center justify-center gap-2 text-[12.5px] font-bold transition"><i class="fas fa-building text-[11px] text-brand-500"></i> إضافة موقع شركة</a>
                                <a href="/Assets" class="h-10 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 flex items-center justify-center gap-2 text-[12.5px] font-bold transition"><i class="fas fa-cubes text-[11px] text-brand-500"></i> عرض كل الأصول</a>
                                <a href="/InventoryAudits" class="h-10 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 flex items-center justify-center gap-2 text-[12.5px] font-bold transition"><i class="fas fa-clipboard-check text-[11px] text-brand-500"></i> جرد المخازن</a>
                            </div>
                        </div>
                        <div class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-4">
                            <h3 class="text-[14px] font-extrabold text-slate-800 mb-3"><i class="fas fa-chart-simple text-brand-500 text-[12px]"></i> معلومات المخازن</h3>
                            <p class="text-[11px] text-slate-400 mb-2">الأصول موزعة كالتالي:</p>
                            @if (Model.TopWarehouses.Count == 0)
                            {
                                <p class="text-[11.5px] text-slate-400">لا توجد مخازن لعرض توزيعها.</p>
                            }
                            <div class="flex flex-col gap-2.5">
                                @foreach (var w in Model.TopWarehouses)
                                {
                                    var row = Model.Items.First(x => x.Id == w.Id);
                                    var pct = Model.Items.Count > 0
                                        ? Math.Min(100, row.AssetCount * 100 / Math.Max(1, Model.Items.Max(i => i.AssetCount)))
                                        : 0;
                                    <div class="flex items-center gap-2">
                                        <span class="text-[11.5px] font-semibold text-slate-600 flex-1 truncate" data-notranslate>@w.Name</span>
                                        <span class="text-[11.5px] font-extrabold text-slate-700">@row.AssetCount</span>
                                        <span class="w-16 h-[6px] bg-slate-100 rounded-full overflow-hidden">
                                            <span class="block h-full rounded-full bg-brand-500" style="width:@pct%"></span>
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>
