@model WarehouseDetailsViewModel
@{
    // بطاقة المخزن: ما بداخله، وقيمتها، وآخر نقلاته.
    Layout = null;
    ViewData["Title"] = Model.NameAr;
    ViewData["NavActive"] = "warehouses";
    var back = "/Warehouses";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
@await Html.PartialAsync("_Head")
<body class="bg-[#e9f1fc] font-sans text-slate-800 antialiased overflow-hidden">
    @await Html.PartialAsync("_ModernBackdrop")

    <div class="h-screen flex flex-col gap-3 p-3 relative z-10">
        @await Html.PartialAsync("_TopBar")

        <div class="flex-1 flex gap-3 min-h-0">
            @await Html.PartialAsync("_SideNav")

            <main class="flex-1 min-w-0 overflow-y-auto pe-0.5">
                @await Html.PartialAsync("_ToastModern")

                <!-- الرأس -->
                <div class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-4 mb-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-center gap-3 min-w-0">
                            <a href="@back" title="رجوع" class="w-11 h-11 rounded-xl border border-slate-200 text-slate-500 hover:text-brand-600 hover:border-brand-300 flex items-center justify-center shrink-0 transition"><i class="fas fa-arrow-right text-[15px]"></i></a>
                            <span class="w-11 h-11 rounded-xl bg-[#e7f0fe] text-brand-600 flex items-center justify-center shrink-0">
                                <i class="fas fa-warehouse text-[17px]"></i>
                            </span>
                            <div class="min-w-0">
                                <h1 class="text-[22px] font-extrabold text-slate-800 leading-tight truncate" data-notranslate>@Model.NameAr</h1>
                                <p class="text-[12px] text-slate-400 -mt-0.5">
                                    مخزن
                                    @if (!string.IsNullOrEmpty(Model.Code))
                                    {
                                        <span> — كود <span dir="ltr" data-notranslate>@Model.Code</span></span>
                                    }
                                    @if (Model.SiteId != null)
                                    {
                                        <span> — تابع لفرع <a href="/CompanySites/Details/@Model.SiteId" class="text-brand-600 hover:underline" data-notranslate>@Model.SiteName</a></span>
                                    }
                                    else
                                    {
                                        <span> — بلا فرع، وهو وضع كامل: المخزن لا يحتاج موقع شركة ليكون مخزنًا</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold rounded-full px-2.5 py-1 @(Model.IsActive ? "bg-emerald-50 text-emerald-600" : "bg-slate-100 text-slate-400")">
                                <span class="w-1.5 h-1.5 rounded-full @(Model.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                @(Model.IsActive ? "نشط" : "موقوف")
                            </span>
                            <a href="/Warehouses/Edit/@Model.Id" class="h-10 px-4 rounded-xl border border-brand-200 text-brand-600 hover:bg-blue-50 flex items-center gap-2 text-[12.5px] font-bold transition">
                                <i class="fas fa-pencil text-[11px]"></i> تعديل
                            </a>
                            <a href="/Assets?warehouseId=@Model.Id" class="h-10 px-4 rounded-xl bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] text-white flex items-center gap-2 text-[12.5px] font-bold shadow-lg shadow-blue-200 transition">
                                <i class="fas fa-cubes text-[11px]"></i> كل الأصول هنا
                            </a>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <p class="mt-3 text-[12.5px] text-slate-500 bg-blue-50/60 rounded-xl px-3 py-2" data-notranslate>@Model.Notes</p>
                    }
                </div>

                <!-- الملخص -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3">
                    <div class="bg-white rounded-2xl p-4 border border-slate-100 flex items-center justify-between">
                        <span>
                            <span class="block text-[16px] font-extrabold text-slate-800">@Model.AssetCount</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">أصول هنا</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-[#e7f0fe] flex items-center justify-center text-brand-500"><i class="fas fa-cubes text-[14px]"></i></span>
                    </div>
                    <div class="bg-white rounded-2xl p-4 border border-slate-100 flex items-center justify-between">
                        <span>
                            <span class="block text-[16px] font-extrabold text-slate-800">@Model.TotalValue.ToString("N0") <span class="text-[11px] text-slate-400">ج.م</span></span>
                            <span class="block text-[12px] text-slate-500 font-semibold">قيمة الشراء</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-[#e9f8ef] flex items-center justify-center text-emerald-500"><i class="fas fa-coins text-[14px]"></i></span>
                    </div>
                    <div class="bg-white rounded-2xl p-4 border border-slate-100 flex items-center justify-between">
                        <span>
                            <span class="block text-[16px] font-extrabold text-slate-800">@Model.InCustodyCount</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">في عهدة موظفين</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-[#fdf2e6] flex items-center justify-center text-amber-500"><i class="fas fa-user-tag text-[14px]"></i></span>
                    </div>
                    <div class="bg-white rounded-2xl p-4 border border-slate-100 flex items-center justify-between">
                        <span>
                            <span class="block text-[16px] font-extrabold text-slate-800">@Model.UnderMaintenance</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">تحت الصيانة</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-[#fdecec] flex items-center justify-center text-red-400"><i class="fas fa-screwdriver-wrench text-[14px]"></i></span>
                    </div>
                </div>

                <div class="flex flex-col xl:flex-row gap-3 items-start">
                    <!-- الأصول داخله -->
                    <div class="flex-1 min-w-0 bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-2">
                        <h3 class="text-[14px] font-extrabold text-slate-800 px-3 py-2"><i class="fas fa-cubes text-brand-500 text-[12px]"></i> الأصول داخله</h3>
                        @if (Model.Assets.Count == 0)
                        {
                            <p class="text-center text-[13px] text-slate-400 py-8">لا أصول مرتبطة بهذا المخزن بعد</p>
                        }
                        @foreach (var a in Model.Assets)
                        {
                            <a href="/Assets/Details/@a.Id" class="grid grid-cols-[minmax(120px,1fr)_96px_120px] items-center gap-3 px-3 py-2.5 border-b border-slate-50 last:border-0 hover:bg-blue-50/30 transition">
                                <span class="min-w-0">
                                    <span class="block text-[13px] font-bold text-slate-800 truncate" data-notranslate>@a.NameAr</span>
                                    <span class="block text-[10.5px] text-slate-400 truncate" dir="ltr" data-notranslate>@a.AssetTag</span>
                                </span>
                                <span class="text-[11.5px] font-bold text-slate-500">@DisplayHelper.Name(a.Status)</span>
                                <span class="text-left text-[11px] text-slate-300"><i class="fas fa-arrow-left text-[9px]"></i> بطاقة الأصل</span>
                            </a>
                        }
                        @if (Model.HasMoreAssets)
                        {
                            <p class="text-[11.5px] text-slate-400 px-3 py-2">
                                المعروض @Model.Assets.Count / @Model.AssetCount —
                                <a href="/Assets?warehouseId=@Model.Id" class="font-bold text-brand-600 hover:underline">عرض الكل</a>
                            </p>
                        }
                    </div>

                    <!-- النقلات -->
                    <div class="w-full xl:w-[340px] shrink-0 bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-2">
                        <h3 class="text-[14px] font-extrabold text-slate-800 px-3 py-2"><i class="fas fa-right-left text-brand-500 text-[12px]"></i> آخر النقلات</h3>
                        @if (Model.Moves.Count == 0)
                        {
                            <p class="text-center text-[12.5px] text-slate-400 py-8">لا نقلات مسجّلة — تُكتب النقلة عند إرجاع عهدة إلى مخزن أو عند نقل الأصل.</p>
                        }
                        @foreach (var m in Model.Moves)
                        {
                            <div class="px-3 py-2.5 border-b border-slate-50 last:border-0">
                                <a href="/Assets/Details/@m.AssetId" class="block text-[12.5px] font-bold text-slate-700 truncate hover:text-brand-600" data-notranslate>@m.AssetName</a>
                                <p class="text-[11px] text-slate-400 mt-0.5">
                                    <span data-notranslate>@(m.FromName ?? "—")</span>
                                    <i class="fas fa-arrow-left text-[9px] mx-1"></i>
                                    <span data-notranslate>@(m.ToName ?? "—")</span>
                                </p>
                                <p class="text-[10.5px] text-slate-300 mt-0.5">
                                    @DisplayHelper.DateTimeDash(m.MovedAt)
                                    @if (!string.IsNullOrEmpty(m.Reason))
                                    {
                                        <span> — <span>@m.Reason</span></span>
                                    }
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>
