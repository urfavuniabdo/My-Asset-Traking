@model AssetIndexViewModel
@using System.Globalization
@using System.Security.Claims
@using AssetTracking.Domain.Enums
@using AssetTracking.Web.Configuration
@inject Microsoft.Extensions.Options.IOptions<FeatureFlags> FeatureOptions
@{
    // لوحة الأصول الحديثة — لمدير النظام فقط (حتى إشعار آخر)
    Layout = null;
    ViewData["Title"] = "الأصول";
    var F = FeatureOptions.Value;
    var fullName = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "";
    var roleLabel = User.IsInRole(Roles.Admin) ? "مدير النظام"
        : User.IsInRole(Roles.CompanyManager) ? "مدير شركة"
        : User.IsInRole(Roles.Technician) ? "فني دعم" : "موظف";
    var ar = new CultureInfo("ar-EG");
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "—";

    string CatIcon(string c) => c.Contains("لابتوب") || c.Contains("حاسوب") ? "fa-laptop"
        : c.Contains("طابع") ? "fa-print"
        : c.Contains("شاشة") ? "fa-desktop"
        : c.Contains("عرض") || c.Contains("بروجكتور") || c.Contains("بروجكتر") ? "fa-tv"
        : c.Contains("شبك") || c.Contains("راوتر") || c.Contains("مودم") ? "fa-wifi"
        : c.Contains("هاتف") || c.Contains("موبايل") ? "fa-mobile-screen"
        : c.Contains("كامير") ? "fa-camera"
        : c.Contains("حساس") ? "fa-tower-broadcast"
        : c.Contains("تحكم") ? "fa-microchip"
        : c.Contains("معدات") || c.Contains("محرّك") || c.Contains("موتور") || c.Contains("مكين") ? "fa-gears"
        : "fa-box";

    string StLabel(AssetStatus s) => s switch
    {
        AssetStatus.Active => "نشط",
        AssetStatus.InStore => "في المخزن",
        AssetStatus.UnderMaintenance => "قيد الصيانة",
        AssetStatus.Damaged => "تالف",
        AssetStatus.Disposed => "مستبعد",
        _ => "مفقود"
    };
    string StCls(AssetStatus s) => s switch
    {
        AssetStatus.Active => "bg-emerald-50 text-emerald-600",
        AssetStatus.InStore => "bg-blue-50 text-blue-600",
        AssetStatus.UnderMaintenance => "bg-amber-50 text-amber-600",
        AssetStatus.Damaged or AssetStatus.Lost => "bg-red-50 text-red-600",
        _ => "bg-slate-100 text-slate-500"
    };
    string StDot(AssetStatus s) => s switch
    {
        AssetStatus.Active => "bg-emerald-500",
        AssetStatus.InStore => "bg-blue-500",
        AssetStatus.UnderMaintenance => "bg-amber-500",
        AssetStatus.Damaged or AssetStatus.Lost => "bg-red-500",
        _ => "bg-slate-400"
    };

    // بناء روابط تحافظ على الفلاتر الحالية
    string Qs(string? sort = null, int? page = null)
    {
        var ps = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Q)) ps.Add("q=" + Uri.EscapeDataString(Model.Q));
        if (Model.CategoryId != null) ps.Add("categoryId=" + Model.CategoryId);
        if (Model.LocationId != null) ps.Add("locationId=" + Model.LocationId);
        if (Model.DepartmentId != null) ps.Add("departmentId=" + Model.DepartmentId);
        if (Model.Status != null) ps.Add("status=" + (int)Model.Status);
        if (sort != null) ps.Add("sort=" + sort);
        if (page != null && page > 1) ps.Add("page=" + page);
        return "/Assets" + (ps.Count > 0 ? "?" + string.Join("&", ps) : "");
    }
    string SortToggle(string col, string asc, string desc)
        => Qs(Model.Sort == asc ? desc : asc);

    var statuses = new[] {
        (1, "نشط"), (2, "في المخزن"), (3, "قيد الصيانة"),
        (4, "تالف"), (5, "مستبعد"), (6, "مفقود")
    };
    var navItems = new List<(string Href, string Label, string Icon, bool Show, bool Active)> {
        ("/", "الرئيسية", "fa-house", true, false),
        ("/Assets", "الأصول", "fa-cubes", true, true),
        ("/InventoryAudits", "المخزون", "fa-boxes-stacked", F.InventoryAudits, false),
        ("/Custody", "إدارة العهد", "fa-right-left", true, false),
        ("/Tickets", "الدعم الفني", "fa-headset", F.Tickets, false),
        ("/Reports", "التقارير", "fa-chart-line", F.Reports, false),
        ("/Admin", "الإعدادات", "fa-gear", true, false)
    };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — نظام إدارة الأصول</title>
    <link rel="icon" type="image/png" href="~/img/login-logo.png" asp-append-version="true">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Cairo', 'system-ui', 'sans-serif'] },
                    colors: {
                        brand: {
                            50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa',
                            500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
    </style>
</head>
<body class="bg-[#e9f1fc] font-sans text-slate-800 antialiased overflow-hidden">
    <!-- خلفية زخرفية -->
    <div class="fixed inset-0 pointer-events-none z-0">
        <svg class="absolute top-24 -right-10 w-[300px] opacity-60" viewBox="0 0 300 200" fill="none">
            <path d="M-20 120 C 60 50, 160 160, 260 90 S 340 40, 340 90" stroke="#d7e7fb" stroke-width="46" stroke-linecap="round"/>
        </svg>
    </div>

    <div class="h-screen flex flex-col gap-3 p-3 relative z-10">
        <!-- ══ الشريط العلوي ══ -->
        <header class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.06)] h-[66px] shrink-0 flex items-center px-5 gap-4 relative z-30">
            <a href="/" class="flex items-center gap-2.5 shrink-0">
                <span class="w-10 h-10 rounded-xl bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] flex items-center justify-center text-white shadow-lg shadow-blue-200 rotate-[-6deg]"><i class="fas fa-cube text-[17px]"></i></span>
                <span class="text-[19px] font-extrabold text-slate-800">نظام إدارة الأصول</span>
            </a>
            <form action="/Assets" method="get" role="search" class="hidden md:block flex-1 max-w-[540px] mx-auto relative">
                <input name="q" value="@Model.Q" placeholder="ابحث عن أصل أو موقع أو رقم..."
                       class="w-full h-11 bg-[#f1f5fa] rounded-full px-12 text-[13.5px] text-slate-700 placeholder-slate-400 outline-none focus:ring-2 focus:ring-brand-400/50 transition">
                <i class="fas fa-magnifying-glass absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-[14px]"></i>
            </form>
            <div class="flex items-center gap-3 shrink-0 ms-auto">
                <a href="/Notifications" title="الإشعارات" class="relative w-10 h-10 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-500 transition">
                    <i class="far fa-bell text-[17px]"></i>
                    <span class="absolute top-2 right-2.5 w-2 h-2 rounded-full bg-red-500 ring-2 ring-white"></span>
                </a>
                <div class="relative">
                    <button type="button" id="user-btn" class="flex items-center gap-2.5 rounded-full hover:bg-slate-100 pl-2 pr-1 py-1 transition">
                        <i class="fas fa-chevron-down text-[11px] text-slate-400"></i>
                        <span class="text-left leading-tight">
                            <span class="block text-[13.5px] font-bold text-slate-800">@fullName</span>
                            <span class="block text-[11px] text-slate-400">@roleLabel</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-[#e7f0fe] text-brand-600 flex items-center justify-center"><i class="fas fa-user text-[15px]"></i></span>
                    </button>
                    <div id="user-menu" class="hidden absolute left-0 top-[110%] w-52 bg-white rounded-xl shadow-xl border border-slate-100 py-1.5 z-50">
                        <a href="/Account/Profile" class="flex items-center gap-2.5 px-4 py-2 text-[13px] text-slate-600 hover:bg-slate-50"><i class="fas fa-user w-4 text-slate-400"></i> الملف الشخصي</a>
                        <a href="/Account/ChangePassword" class="flex items-center gap-2.5 px-4 py-2 text-[13px] text-slate-600 hover:bg-slate-50"><i class="fas fa-key w-4 text-slate-400"></i> تغيير كلمة المرور</a>
                        <hr class="my-1 border-slate-100">
                        <form method="post" action="/Account/Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full flex items-center gap-2.5 px-4 py-2 text-[13px] text-red-500 hover:bg-red-50"><i class="fas fa-right-from-bracket w-4"></i> تسجيل الخروج</button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 flex gap-3 min-h-0">
            <!-- ══ القائمة الجانبية ══ -->
            <nav class="w-[228px] shrink-0 bg-white rounded-3xl shadow-[0_2px_12px_rgba(30,90,180,0.06)] p-3.5 flex flex-col relative z-10">
                <ul class="flex flex-col gap-1">
                    @foreach (var n in navItems.Where(n => n.Show))
                    {
                        <li>
                            <a href="@n.Href"
                               class="@(n.Active
                                   ? "bg-[#e7f0fe] text-brand-700"
                                   : "text-slate-600 hover:bg-blue-50/70 hover:text-brand-700")
                                  flex items-center gap-3 rounded-xl px-4 h-[46px] text-[14.5px] font-bold transition">
                                <span class="@(n.Active ? "text-brand-600" : "text-brand-500")"><i class="fas @n.Icon text-[15px]"></i></span>
                                @n.Label
                            </a>
                        </li>
                    }
                </ul>
                <div class="mt-auto text-center text-[12px] text-slate-400 pb-2">نحو إدارة أذكى للأصول</div>
            </nav>

            <!-- ══ المحتوى ══ -->
            <main class="flex-1 min-w-0 overflow-y-auto pe-0.5">
                <!-- العنوان + الأزرار -->
                <div class="flex items-start justify-between gap-4 mb-3 px-1">
                    <div class="flex items-center gap-3">
                        <span class="w-11 h-11 rounded-xl bg-[#e7f0fe] text-brand-600 flex items-center justify-center"><i class="fas fa-cubes text-[18px]"></i></span>
                        <div>
                            <h1 class="text-[26px] font-extrabold text-slate-800 leading-tight">الأصول</h1>
                            <p class="text-[12.5px] text-slate-400 -mt-0.5">إدارة ومتابعة جميع أصول الشركة</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="/Reports" class="h-11 px-4 bg-white border border-slate-200 hover:border-brand-300 hover:text-brand-700 rounded-xl flex items-center gap-2 text-[13px] font-bold text-slate-600 transition">
                            <i class="fas fa-file-export text-brand-500"></i> تصدير
                        </a>
                        <a href="/Assets/Scan" class="h-11 px-4 bg-white border border-slate-200 hover:border-brand-300 hover:text-brand-700 rounded-xl flex items-center gap-2 text-[13px] font-bold text-slate-600 transition">
                            <i class="fas fa-qrcode text-brand-500"></i> مسح QR
                        </a>
                        @if (Model.CanEdit)
                        {
                            <a href="/Assets/Create" class="h-11 px-5 bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] hover:from-[#2f78ef] hover:to-[#1745c9] rounded-xl flex items-center gap-2 text-[13.5px] font-bold text-white shadow-lg shadow-blue-200 transition">
                                <i class="fas fa-plus text-[12px]"></i> إضافة أصل
                            </a>
                        }
                    </div>
                </div>

                <!-- بطاقات الملخص -->
                <div class="grid grid-cols-3 gap-3 mb-3">
                    <a href="/Assets" class="bg-[#d2e4fc] rounded-2xl p-4 flex items-center justify-between hover:shadow-md transition">
                        <span class="text-right">
                            <span class="block text-[16px] font-extrabold text-slate-800">@ViewData["AllAssets"]</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">إجمالي الأصول</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-brand-500"><i class="fas fa-cube text-[14px]"></i></span>
                    </a>
                    <a href="/Assets?status=3" class="bg-[#fdecec] rounded-2xl p-4 flex items-center justify-between hover:shadow-md transition">
                        <span class="text-right">
                            <span class="block text-[16px] font-extrabold text-slate-800">@ViewData["FollowUp"]</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">أصول تحتاج متابعة</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-red-400"><i class="fas fa-circle-exclamation text-[14px]"></i></span>
                    </a>
                    <a href="/Assets" class="bg-[#e9f8ef] rounded-2xl p-4 flex items-center justify-between hover:shadow-md transition">
                        <span class="text-right">
                            <span class="block text-[16px] font-extrabold text-slate-800">@ViewData["WarrantySoon"]</span>
                            <span class="block text-[12px] text-slate-500 font-semibold">ضمان ينتهي قريبًا</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-emerald-500"><i class="fas fa-shield-halved text-[14px]"></i></span>
                    </a>
                </div>

                <!-- شريط الفلاتر -->
                <form method="get" action="/Assets" class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-3 mb-3 flex items-end gap-2.5 flex-wrap">
                    <div class="flex-1 min-w-[200px] relative">
                        <input name="q" value="@Model.Q" placeholder="ابحث باسم الأصل أو كوده..."
                               class="w-full h-11 bg-[#f1f5fa] rounded-xl px-4 text-[13px] text-slate-700 placeholder-slate-400 outline-none focus:ring-2 focus:ring-brand-400/50 transition">
                    </div>
                    <div class="w-[150px]">
                        <select name="categoryId" onchange="this.form.submit()"
                                class="w-full h-11 bg-[#f1f5fa] rounded-xl px-3 text-[12.5px] text-slate-600 outline-none focus:ring-2 focus:ring-brand-400/50 appearance-none cursor-pointer">
                            <option value="">التصنيف: الكل</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="w-[150px]">
                        <select name="locationId" onchange="this.form.submit()"
                                class="w-full h-11 bg-[#f1f5fa] rounded-xl px-3 text-[12.5px] text-slate-600 outline-none focus:ring-2 focus:ring-brand-400/50 appearance-none cursor-pointer">
                            <option value="">الموقع: الكل</option>
                            @foreach (var l in Model.Locations)
                            {
                                <option value="@l.Id" selected="@(Model.LocationId == l.Id)">@l.Name</option>
                            }
                        </select>
                    </div>
                    <div class="w-[150px]">
                        <select name="status" onchange="this.form.submit()"
                                class="w-full h-11 bg-[#f1f5fa] rounded-xl px-3 text-[12.5px] text-slate-600 outline-none focus:ring-2 focus:ring-brand-400/50 appearance-none cursor-pointer">
                            <option value="">الحالة: الكل</option>
                            @foreach (var (val, lbl) in statuses)
                            {
                                <option value="@val" selected="@(Model.Status == (AssetStatus)val)">@lbl</option>
                            }
                        </select>
                    </div>
                    <a href="/Assets" class="h-11 px-4 bg-white border border-slate-200 hover:border-brand-300 rounded-xl flex items-center gap-2 text-[12.5px] font-bold text-slate-500 transition">
                        <i class="fas fa-rotate-right text-brand-500 text-[12px]"></i> إعادة تعيين
                    </a>
                </form>

                <!-- جدول الأصول -->
                <div class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-2">
                    <div class="grid grid-cols-[minmax(180px,1.4fr)_110px_minmax(110px,1fr)_minmax(140px,1.1fr)_110px_100px_110px] items-center px-4 py-2.5 text-[11.5px] font-bold text-slate-400 border-b border-slate-100">
                        <span>الاسم</span>
                        <span>كود الأصل</span>
                        <span>التصنيف</span>
                        <span>الموقع</span>
                        <span>الحالة</span>
                        <span>تاريخ الضمان</span>
                        <span class="text-left">الإجراءات</span>
                    </div>
                    @if (Model.Items.Count == 0)
                    {
                        <p class="text-center text-[13px] text-slate-400 py-10"><i class="fas fa-box-open text-[20px] block mb-2 text-slate-300"></i>لا توجد أصول مطابقة</p>
                    }
                    @foreach (var a in Model.Items)
                    {
                        <div class="grid grid-cols-[minmax(180px,1.4fr)_110px_minmax(110px,1fr)_minmax(140px,1.1fr)_110px_100px_110px] items-center px-4 py-2 border-b border-slate-50 last:border-0 hover:bg-blue-50/30 transition">
                            <span class="flex items-center gap-2.5 min-w-0">
                                <span class="w-9 h-9 rounded-lg bg-[#e7f0fe] text-brand-600 flex items-center justify-center shrink-0"><i class="fas @(CatIcon(a.CategoryName ?? "")) text-[13px]"></i></span>
                                <span class="truncate text-[13px] font-bold text-slate-800">@a.NameAr</span>
                            </span>
                            <span><a href="/Assets/Details/@a.Id" class="text-[12.5px] font-extrabold text-brand-600 hover:underline" dir="ltr">@a.AssetTag</a></span>
                            <span class="flex items-center gap-2 text-[12px] text-slate-500 truncate">
                                <i class="fas @(CatIcon(a.CategoryName ?? "")) text-[11px] text-slate-400"></i> @a.CategoryName
                            </span>
                            <span class="flex items-center gap-1.5 text-[12px] text-slate-500 truncate">
                                <i class="fas fa-location-dot text-[10.5px] text-slate-400"></i> @(a.LocationName ?? "—")
                            </span>
                            <span><span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold rounded-full px-2.5 py-1 @StCls(a.Status)"><span class="w-1.5 h-1.5 rounded-full @StDot(a.Status)"></span> @StLabel(a.Status)</span></span>
                            <span class="text-[11.5px] text-slate-500" dir="ltr">@D(a.WarrantyEndDate)</span>
                            <span class="flex items-center justify-start gap-1.5">
                                <a href="/Assets/Qr/@a.Id" target="_blank" title="رمز QR" class="w-7 h-7 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-qrcode text-[11px]"></i></a>
                                @if (Model.CanEdit)
                                {
                                    <a href="/Assets/Edit/@a.Id" title="تعديل" class="w-7 h-7 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-pencil text-[11px]"></i></a>
                                }
                                <a href="/Assets/Details/@a.Id" title="التفاصيل" class="w-7 h-7 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-ellipsis-vertical text-[11px]"></i></a>
                            </span>
                        </div>
                    }
                </div>

                <!-- الترقيم -->
                @if (Model.TotalPages > 1)
                {
                    <div class="flex items-center justify-center gap-1.5 mt-3 mb-1">
                        @if (Model.Page > 1)
                        {
                            <a href="@Qs(page: Model.Page - 1)" class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-chevron-right text-[11px]"></i></a>
                        }
                        @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                        {
                            <a href="@Qs(page: p)" class="w-9 h-9 rounded-xl flex items-center justify-center text-[13px] font-bold transition @(p == Model.Page ? "bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] text-white shadow-md shadow-blue-200" : "bg-white border border-slate-200 text-slate-500 hover:text-brand-600 hover:border-brand-300")">@p</a>
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a href="@Qs(page: Model.Page + 1)" class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-chevron-left text-[11px]"></i></a>
                        }
                    </div>
                }
            </main>
        </div>
    </div>

    <script>
        var btn = document.getElementById('user-btn'), menu = document.getElementById('user-menu');
        btn?.addEventListener('click', function (e) { e.stopPropagation(); menu.classList.toggle('hidden'); });
        document.addEventListener('click', function () { menu?.classList.add('hidden'); });
    </script>
</body>
</html>
