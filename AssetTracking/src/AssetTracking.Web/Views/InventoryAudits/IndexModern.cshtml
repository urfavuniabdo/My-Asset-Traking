@model AuditIndexViewModel
@using System.Globalization
@using AssetTracking.Domain.Enums
@using AssetTracking.Web.Configuration
@inject Microsoft.Extensions.Options.IOptions<FeatureFlags> FeatureOptions
@{
    // لوحة الجرد الحديثة — لمدير النظام فقط (حتى إشعار آخر)
    Layout = null;
    ViewData["Title"] = "الجرد الدوري للأصول";
    ViewData["NavActive"] = "audits";
    var F = FeatureOptions.Value;
    var fullName = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "";
    var roleLabel = User.IsInRole(Roles.Admin) ? "مدير النظام"
        : User.IsInRole(Roles.CompanyManager) ? "مدير شركة"
        : User.IsInRole(Roles.Technician) ? "فني دعم" : "موظف";
    var ar = new CultureInfo("ar-EG");
    string D(DateTime d) => d.ToString("yyyy-MM-dd", ar);

    string StChip(AuditStatus s) => s switch
    {
        AuditStatus.InProgress => "جاري التنفيذ",
        AuditStatus.Completed => "مكتمل",
        AuditStatus.Cancelled => "ملغي",
        _ => "مسودة"
    };
    string StCls(AuditStatus s) => s switch
    {
        AuditStatus.InProgress => "bg-blue-50 text-blue-600",
        AuditStatus.Completed => "bg-emerald-50 text-emerald-600",
        AuditStatus.Cancelled => "bg-red-50 text-red-500",
        _ => "bg-slate-100 text-slate-500"
    };
    int Pct(AuditListRow a) => a.TotalExpected > 0 ? Math.Min(100, a.TotalScanned * 100 / a.TotalExpected) : 0;
    string PctColor(int p) => p >= 100 ? "#10b981" : p > 0 ? "#3b82f6" : "#cbd5e1";

    // أول جلسة فيها نواقص لزر المراجعة
    var reviewTarget = Model.Items.FirstOrDefault(x => x.TotalMissing > 0);

    string Qs(string? key = null, string? val = null, int? page = null)
    {
        var ps = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Q)) ps.Add("q=" + Uri.EscapeDataString(Model.Q));
        if (Model.Status != null) ps.Add("status=" + (int)Model.Status);
        if (Model.LocationId != null) ps.Add("locationId=" + Model.LocationId);
        if (key == "from" && val != null) ps.Add("from=" + val);
        if (key == "to" && val != null) ps.Add("to=" + val);
        if (page != null && page > 1) ps.Add("page=" + page);
        return "/InventoryAudits" + (ps.Count > 0 ? "?" + string.Join("&", ps) : "");
    }

    var auditStatuses = new[] { (1, "مسودة"), (2, "جاري التنفيذ"), (3, "مكتمل"), (4, "ملغي") };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — نظام إدارة الأصول</title>
    <link rel="icon" type="image/png" href="~/img/login-logo.png" asp-append-version="true">
    <!-- PWA: app icon when installed from the browser -->
    <link rel="manifest" href="~/manifest.webmanifest">
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png">
    <meta name="theme-color" content="#2563eb">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/sidenav.css" rel="stylesheet" asp-append-version="true">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Cairo', 'system-ui', 'sans-serif'] },
                    colors: {
                        brand: {
                            50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa',
                            500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
    </style>
</head>
<body class="bg-[#e9f1fc] font-sans text-slate-800 antialiased overflow-hidden">
    <!-- خلفية زخرفية -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" style="background:linear-gradient(180deg,#e7f0fc 0%,#edf4fd 50%,#f7fbfe 100%)">
        <svg class="absolute bottom-0 left-0 w-[600px] h-[310px]" viewBox="0 0 600 300" preserveAspectRatio="none">
            <path d="M0 105 C 110 25, 215 165, 335 105 C 435 55, 525 70, 600 130 L600 300 L0 300 Z" fill="#ddecfd"/>
            <path d="M0 145 C 90 70, 195 195, 325 140 C 445 92, 535 120, 600 195 L600 300 L0 300 Z" fill="#c6ddfb" opacity="0.8"/>
            <path d="M0 215 C 130 150, 265 245, 405 200 C 505 168, 565 205, 600 235 L600 300 L0 300 Z" fill="#b6d8fd" opacity="0.65"/>
        </svg>
        <svg class="absolute bottom-0 left-0 w-full h-[64px]" viewBox="0 0 1600 64" preserveAspectRatio="none">
            <path d="M0 38 C 300 0, 700 58, 1000 28 C 1250 6, 1450 30, 1600 18 L1600 64 L0 64 Z" fill="#e2f1fd" opacity="0.9"/>
        </svg>
        <div class="absolute bottom-[-50px] right-[-20px] w-[320px] h-[320px]">
            <div class="absolute inset-0 rounded-full" style="background:radial-gradient(circle at 35% 30%, #f2f8fe 0%, #e4eefc 55%, #d9e9fb 100%)"></div>
            <svg class="absolute top-8 right-10 w-[150px] rotate-[-8deg]" viewBox="0 0 200 220">
                <defs>
                    <linearGradient id="cubeTop" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f8fbff"/><stop offset="1" stop-color="#e3effd"/></linearGradient>
                    <linearGradient id="cubeLeft" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#dcebfd"/><stop offset="1" stop-color="#c9def9"/></linearGradient>
                    <linearGradient id="cubeRight" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#cfe2fb"/><stop offset="1" stop-color="#e1effd"/></linearGradient>
                </defs>
                <polygon points="100,8 188,56 100,104 12,56" fill="url(#cubeTop)"/>
                <polygon points="12,56 100,104 100,212 12,164" fill="url(#cubeLeft)"/>
                <polygon points="188,56 100,104 100,212 188,164" fill="url(#cubeRight)"/>
            </svg>
        </div>
    </div>

    <div class="h-screen flex flex-col gap-3 p-3 relative z-10">
        @await Html.PartialAsync("_TopBar")

        <div class="flex-1 flex gap-3 min-h-0">
            @await Html.PartialAsync("_SideNav")

            <!-- ══ المحتوى ══ -->
            <main class="flex-1 min-w-0 overflow-y-auto pe-0.5">
                <!-- بار التبويبات -->
                <div class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-1.5 inline-flex gap-1 mb-3">
                    <a href="/Warehouses" class="h-10 px-7 rounded-xl text-slate-500 hover:bg-blue-50 hover:text-brand-600 text-[13.5px] font-bold flex items-center transition">
                        <i class="fas fa-warehouse text-[12px] me-2"></i> إدارة المخازن
                    </a>
                    <a href="/InventoryAudits" class="h-10 px-7 rounded-xl bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] text-white text-[13.5px] font-bold flex items-center shadow-md shadow-blue-200">
                        <i class="fas fa-clipboard-check text-[12px] me-2"></i> الجرد
                    </a>
                </div>

                <!-- العنوان + الأزرار -->
                <div class="flex items-start justify-between gap-4 mb-3 px-1">
                    <div class="flex items-center gap-3">
                        <span class="w-11 h-11 rounded-xl bg-[#e7f0fe] text-brand-600 flex items-center justify-center"><i class="fas fa-clipboard-check text-[17px]"></i></span>
                        <div>
                            <h1 class="text-[26px] font-extrabold text-slate-800 leading-tight">الجرد الدوري للأصول</h1>
                            <p class="text-[12.5px] text-slate-400 -mt-0.5">متابعة عمليات الجرد الدورية للأصول واكتشاف الفروقات إن وجدت</p>
                        </div>
                    </div>
                    @if (Model.CanEdit)
                    {
                        <a href="/InventoryAudits/Create" class="h-11 px-5 bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] hover:from-[#2f78ef] hover:to-[#1745c9] rounded-xl flex items-center gap-2 text-[13.5px] font-bold text-white shadow-lg shadow-blue-200 transition">
                            <i class="fas fa-plus text-[12px]"></i> عملية جرد جديدة
                        </a>
                    }
                </div>

                <!-- بطاقات الحالة + كارت المراجعة -->
                <div class="grid grid-cols-5 gap-3 mb-3">
                    <a href="/InventoryAudits?status=1" class="bg-white border border-slate-100 rounded-2xl p-4 relative hover:shadow-md transition">
                        <span class="w-9 h-9 rounded-full bg-violet-50 text-violet-500 flex items-center justify-center mb-2"><i class="far fa-file text-[13px]"></i></span>
                        <span class="block text-[19px] font-extrabold text-slate-800 leading-tight">@Model.CountDraft</span>
                        <span class="block text-[12px] text-slate-500 font-semibold">مسودات</span>
                        <span class="block text-[10.5px] text-slate-400 mt-1.5">عرض الكل <i class="fas fa-chevron-left text-[8px]"></i></span>
                    </a>
                    <a href="/InventoryAudits?status=2" class="bg-white border border-slate-100 rounded-2xl p-4 relative hover:shadow-md transition">
                        <span class="w-9 h-9 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center mb-2"><i class="far fa-clock text-[13px]"></i></span>
                        <span class="block text-[19px] font-extrabold text-slate-800 leading-tight">@Model.CountInProgress</span>
                        <span class="block text-[12px] text-slate-500 font-semibold">جاري التنفيذ</span>
                        <span class="block text-[10.5px] text-slate-400 mt-1.5">عرض الكل <i class="fas fa-chevron-left text-[8px]"></i></span>
                    </a>
                    <a href="/InventoryAudits?status=3" class="bg-white border border-slate-100 rounded-2xl p-4 relative hover:shadow-md transition">
                        <span class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-500 flex items-center justify-center mb-2"><i class="fas fa-circle-check text-[13px]"></i></span>
                        <span class="block text-[19px] font-extrabold text-slate-800 leading-tight">@Model.CountCompleted</span>
                        <span class="block text-[12px] text-slate-500 font-semibold">مكتملة</span>
                        <span class="block text-[10.5px] text-slate-400 mt-1.5">عرض الكل <i class="fas fa-chevron-left text-[8px]"></i></span>
                    </a>
                    <a href="/InventoryAudits" class="bg-[#fdecec] rounded-2xl p-4 relative hover:shadow-md transition">
                        <span class="w-9 h-9 rounded-full bg-white text-red-400 flex items-center justify-center mb-2 shadow-sm"><i class="fas fa-triangle-exclamation text-[13px]"></i></span>
                        <span class="block text-[19px] font-extrabold text-slate-800 leading-tight">@Model.CountMissing</span>
                        <span class="block text-[12px] text-slate-500 font-semibold">نواقص مراجعة</span>
                        <span class="block text-[10.5px] text-slate-400 mt-1.5">عرض الكل <i class="fas fa-chevron-left text-[8px]"></i></span>
                    </a>
                    @if (Model.CountMissing > 0)
                    {
                        <div class="bg-[#e8f1fe] rounded-2xl p-4 flex flex-col justify-center">
                            <div class="flex items-center gap-2.5 mb-1.5">
                                <span class="w-8 h-8 rounded-full bg-white text-brand-600 flex items-center justify-center shadow-sm"><i class="fas fa-circle-exclamation text-[13px]"></i></span>
                                <h3 class="text-[13.5px] font-extrabold text-slate-800">جلسات جرد تحتاج مراجعة</h3>
                            </div>
                            <p class="text-[11.5px] text-slate-500 leading-relaxed mb-2.5">هناك @Model.CountMissing نواقص تحتاج لمراجعة في بعض الجلسات</p>
                            @if (reviewTarget != null)
                            {
                                <a href="/InventoryAudits/Details/@reviewTarget.Id" class="inline-flex items-center gap-2 h-9 px-4 bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] hover:from-[#2f78ef] hover:to-[#1745c9] rounded-xl text-[12px] font-bold text-white shadow-md shadow-blue-200 w-fit transition">
                                    مراجعة النواقص <i class="fas fa-arrow-left text-[10px]"></i>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="bg-[#e9f8ef] rounded-2xl p-4 flex flex-col justify-center">
                            <div class="flex items-center gap-2.5 mb-1.5">
                                <span class="w-8 h-8 rounded-full bg-white text-emerald-500 flex items-center justify-center shadow-sm"><i class="fas fa-circle-check text-[13px]"></i></span>
                                <h3 class="text-[13.5px] font-extrabold text-slate-800">لا نواقص معلّقة</h3>
                            </div>
                            <p class="text-[11.5px] text-slate-500 leading-relaxed">كل الجلسات المكتملة نظيفة — أحسنت</p>
                        </div>
                    }
                </div>

                <!-- شريط الفلاتر -->
                <form method="get" action="/InventoryAudits" class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-3 mb-3 flex items-end gap-2.5 flex-wrap">
                    <div class="flex-1 min-w-[190px] relative">
                        <input name="q" value="@Model.Q" placeholder="ابحث بكود الجرد أو العنوان أو الموقع..."
                               class="w-full h-11 bg-[#f1f5fa] rounded-xl px-4 text-[13px] text-slate-700 placeholder-slate-400 outline-none focus:ring-2 focus:ring-brand-400/50 transition">
                        <i class="fas fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-[12px]"></i>
                    </div>
                    <div class="w-[130px]">
                        <select name="locationId" onchange="this.form.submit()"
                                class="w-full h-11 bg-[#f1f5fa] rounded-xl px-3 text-[12.5px] text-slate-600 outline-none focus:ring-2 focus:ring-brand-400/50 appearance-none cursor-pointer">
                            <option value="">الموقع: الكل</option>
                            @foreach (var l in Model.Locations)
                            {
                                <option value="@l.Id" selected="@(Model.LocationId == l.Id)">@l.Name</option>
                            }
                        </select>
                    </div>
                    <div class="w-[130px]">
                        <select name="status" onchange="this.form.submit()"
                                class="w-full h-11 bg-[#f1f5fa] rounded-xl px-3 text-[12.5px] text-slate-600 outline-none focus:ring-2 focus:ring-brand-400/50 appearance-none cursor-pointer">
                            <option value="">الحالة: الكل</option>
                            @foreach (var (val, lbl) in auditStatuses)
                            {
                                <option value="@val" selected="@(Model.Status == (AuditStatus)val)">@lbl</option>
                            }
                        </select>
                    </div>
                    <div class="w-[135px]">
                        <label class="block text-[10.5px] font-bold text-slate-400 mb-0.5 px-1">من تاريخ</label>
                        <input type="date" name="from" value="@ViewContext.HttpContext.Request.Query["from"]" onchange="this.form.submit()"
                               class="w-full h-11 bg-[#f1f5fa] rounded-xl px-3 text-[12.5px] text-slate-600 outline-none focus:ring-2 focus:ring-brand-400/50 transition" dir="ltr">
                    </div>
                    <div class="w-[135px]">
                        <label class="block text-[10.5px] font-bold text-slate-400 mb-0.5 px-1">إلى تاريخ</label>
                        <input type="date" name="to" value="@ViewContext.HttpContext.Request.Query["to"]" onchange="this.form.submit()"
                               class="w-full h-11 bg-[#f1f5fa] rounded-xl px-3 text-[12.5px] text-slate-600 outline-none focus:ring-2 focus:ring-brand-400/50 transition" dir="ltr">
                    </div>
                    <button type="submit" class="h-11 px-4 bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] rounded-xl flex items-center gap-2 text-[12.5px] font-bold text-white shadow-md shadow-blue-200 transition">
                        <i class="fas fa-filter text-[11px]"></i> تحديث النتائج
                    </button>
                    <a href="/InventoryAudits" class="h-11 px-4 bg-white border border-slate-200 hover:border-brand-300 rounded-xl flex items-center gap-2 text-[12.5px] font-bold text-slate-500 transition">
                        <i class="fas fa-rotate-right text-brand-500 text-[12px]"></i> إعادة تعيين
                    </a>
                </form>

                <!-- جدول جلسات الجرد -->
                <div class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-2">
                    <div class="grid grid-cols-[106px_minmax(160px,1.2fr)_minmax(110px,1fr)_minmax(120px,1fr)_104px_104px_minmax(110px,1fr)_80px_120px] items-center px-4 py-2.5 text-[11.5px] font-bold text-slate-400 border-b border-slate-100">
                        <span>كود الجرد</span>
                        <span>عنوان الجرد</span>
                        <span>الموقع</span>
                        <span>المسؤول</span>
                        <span>التاريخ المخطط</span>
                        <span>الحالة</span>
                        <span>التقدم</span>
                        <span>النواقص</span>
                        <span class="text-left">الإجراءات</span>
                    </div>
                    @if (Model.Items.Count == 0)
                    {
                        <p class="text-center text-[13px] text-slate-400 py-10"><i class="fas fa-clipboard-check text-[20px] block mb-2 text-slate-300"></i>لا توجد جلسات جرد مطابقة</p>
                    }
                    @foreach (var a in Model.Items)
                    {
                        var pct = Pct(a);
                        <div class="grid grid-cols-[106px_minmax(160px,1.2fr)_minmax(110px,1fr)_minmax(120px,1fr)_104px_104px_minmax(110px,1fr)_80px_120px] items-center px-4 py-2.5 border-b border-slate-50 last:border-0 hover:bg-blue-50/30 transition">
                            <span><a href="/InventoryAudits/Details/@a.Id" class="text-[12px] font-extrabold text-brand-600 hover:underline" dir="ltr">@a.Code</a></span>
                            <span class="text-[12.5px] font-bold text-slate-800 truncate">@a.Title</span>
                            <span class="flex items-center gap-1.5 text-[12px] text-slate-500 truncate">
                                <i class="fas fa-location-dot text-[10px] text-slate-400"></i> @(a.LocationName ?? "—")
                            </span>
                            <span class="flex items-center gap-2 text-[12px] text-slate-600 truncate">
                                <span class="w-6 h-6 rounded-full bg-[#e7f0fe] text-brand-600 flex items-center justify-center shrink-0"><i class="fas fa-user text-[9px]"></i></span>
                                @(a.ResponsibleName ?? "—")
                            </span>
                            <span class="text-[11.5px] text-slate-500" dir="ltr">@D(a.ScheduledDate)</span>
                            <span><span class="inline-block text-[11px] font-bold rounded-full px-2.5 py-1 @StCls(a.Status)">@StChip(a.Status)</span></span>
                            <span class="flex items-center gap-2">
                                <span class="text-[11px] font-bold text-slate-600 w-8">@pct%</span>
                                <span class="flex-1 h-[6px] bg-slate-100 rounded-full overflow-hidden min-w-[40px]">
                                    <span class="block h-full rounded-full" style="width:@pct%;background:@PctColor(pct)"></span>
                                </span>
                            </span>
                            <span>
                                @if (a.TotalMissing > 0)
                                {
                                    <span class="inline-flex items-center gap-1 text-[11.5px] font-extrabold text-red-500"><i class="fas fa-triangle-exclamation text-[10px]"></i> @a.TotalMissing</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-[11.5px] font-bold text-slate-400"><i class="fas fa-check text-[10px]"></i> 0</span>
                                }
                            </span>
                            <span class="flex items-center justify-start gap-1.5">
                                <a href="/InventoryAudits/Details/@a.Id" title="عرض" class="w-7 h-7 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-brand-600 hover:border-brand-300 transition"><i class="far fa-eye text-[10.5px]"></i></a>
                                @if (Model.CanEdit)
                                {
                                    <a href="/InventoryAudits/Edit/@a.Id" title="تعديل" class="w-7 h-7 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-pencil text-[10px]"></i></a>
                                }
                                <a href="/InventoryAudits/Details/@a.Id" title="التفاصيل" class="w-7 h-7 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-ellipsis-vertical text-[10px]"></i></a>
                            </span>
                        </div>
                    }
                </div>

                <!-- الترقيم + العدّاد -->
                @if (Model.TotalPages > 1 || Model.TotalCount > 0)
                {
                    <div class="flex items-center justify-between mt-3 mb-1 px-2">
                        <span class="text-[11.5px] text-slate-400">
                            عرض @(Model.TotalCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1)-@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) من @Model.TotalCount عناصر
                        </span>
                        @if (Model.TotalPages > 1)
                        {
                            <div class="flex items-center gap-1.5">
                                @if (Model.Page > 1)
                                {
                                    <a href="@Qs(page: Model.Page - 1)" class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-chevron-right text-[11px]"></i></a>
                                }
                                @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                                {
                                    <a href="@Qs(page: p)" class="w-9 h-9 rounded-xl flex items-center justify-center text-[13px] font-bold transition @(p == Model.Page ? "bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] text-white shadow-md shadow-blue-200" : "bg-white border border-slate-200 text-slate-500 hover:text-brand-600 hover:border-brand-300")">@p</a>
                                }
                                @if (Model.Page < Model.TotalPages)
                                {
                                    <a href="@Qs(page: Model.Page + 1)" class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:text-brand-600 hover:border-brand-300 transition"><i class="fas fa-chevron-left text-[11px]"></i></a>
                                }
                            </div>
                        }
                        else { <span></span> }
                    </div>
                }
            </main>
        </div>
    </div>
