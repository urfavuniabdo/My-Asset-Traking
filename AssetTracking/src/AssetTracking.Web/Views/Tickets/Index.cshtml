@model TicketIndexViewModel
@using AssetTracking.Web.Helpers
@{
    ViewData["Title"] = "تذاكر الصيانة";
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Q) || Model.Status.HasValue
                    || Model.Priority.HasValue || Model.Type.HasValue
                    || !string.IsNullOrWhiteSpace(Model.TechnicianId);
    var scope = Model.Scope ?? "all";

    string ScopeUrl(string s) => Url.Action("Index", new { scope = s })!;
    string ScopeCls(string s) => scope == s ? "btn btn-sm btn-primary" : "btn btn-sm btn-outline-secondary";
}

<div class="page-head">
    <div>
        <h1><i class="bi bi-ticket-perforated"></i> تذاكر الصيانة</h1>
        <p class="page-sub">
            <span class="num">@Model.TotalCount.ToString("N0")</span> تذكرة
            @if (hasFilter) { <span class="badge bg-secondary-subtle text-secondary-emphasis">مُفلتَرة</span> }
        </p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> تذكرة جديدة</a>
    </div>
</div>

<div class="stat-grid">
    <a class="stat-card" href="@Url.Action("Index", new { scope = "open" })">
        <span class="stat-icon blue"><i class="bi bi-folder2-open"></i></span>
        <div class="stat-body">
            <p class="stat-label">مفتوحة (جديدة)</p>
            <p class="stat-value">@Model.CountOpen.ToString("N0")</p>
        </div>
    </a>
    <div class="stat-card">
        <span class="stat-icon amber"><i class="bi bi-tools"></i></span>
        <div class="stat-body">
            <p class="stat-label">قيد المعالجة</p>
            <p class="stat-value">@Model.CountInProgress.ToString("N0")</p>
        </div>
    </div>
    <a class="stat-card" href="@Url.Action("Index", new { scope = "breached" })">
        <span class="stat-icon red"><i class="bi bi-exclamation-octagon"></i></span>
        <div class="stat-body">
            <p class="stat-label">خارقة لـ SLA</p>
            <p class="stat-value">@Model.CountBreached.ToString("N0")</p>
        </div>
    </a>
    <a class="stat-card" href="@Url.Action("Index", new { scope = "unassigned" })">
        <span class="stat-icon gray"><i class="bi bi-person-dash"></i></span>
        <div class="stat-body">
            <p class="stat-label">بدون فني</p>
            <p class="stat-value">@Model.CountUnassigned.ToString("N0")</p>
        </div>
    </a>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="@ScopeCls("all")" href="@ScopeUrl("all")">الكل</a>
    <a class="@ScopeCls("open")" href="@ScopeUrl("open")">غير المغلقة</a>
    @if (Model.CanWork)
    {
        <a class="@ScopeCls("mine")" href="@ScopeUrl("mine")"><i class="bi bi-person-workspace"></i> المُكلَّف بها</a>
        <a class="@ScopeCls("unassigned")" href="@ScopeUrl("unassigned")">بدون فني</a>
    }
    <a class="@ScopeCls("requested")" href="@ScopeUrl("requested")">طلباتي</a>
    <a class="@ScopeCls("breached")" href="@ScopeUrl("breached")"><i class="bi bi-alarm"></i> متأخرة</a>
</div>

<form method="get" class="filter-bar">
    <input type="hidden" name="scope" value="@scope" />
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label">بحث</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input name="q" value="@Model.Q" class="form-control"
                       placeholder="رقم التذكرة، الموضوع، الأصل…" />
            </div>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">الحالة</label>
            <select name="status" class="form-select" data-autosubmit>
                <option value="">الكل</option>
                @foreach (TicketStatus s in Enum.GetValues<TicketStatus>())
                {
                    <option value="@((int)s)" selected="@(Model.Status == s)">@DisplayHelper.Name(s)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">الأولوية</label>
            <select name="priority" class="form-select" data-autosubmit>
                <option value="">الكل</option>
                @foreach (TicketPriority p in Enum.GetValues<TicketPriority>())
                {
                    <option value="@((int)p)" selected="@(Model.Priority == p)">@DisplayHelper.Name(p)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">الفني</label>
            <select name="technicianId" class="form-select" data-autosubmit>
                <option value="">الكل</option>
                @foreach (var t in Model.Technicians)
                {
                    <option value="@t.Id" selected="@(Model.TechnicianId == t.Id)">@t.Name</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel"></i> تطبيق</button>
            @if (hasFilter)
            {
                <a class="btn btn-outline-secondary" href="@ScopeUrl(scope)" title="إلغاء الفلاتر">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </div>
</form>

<div class="table-wrap">
    @if (Model.Items.Count == 0)
    {
        <div class="table-empty">
            <i class="bi bi-inbox"></i>
            <p>لا توجد تذاكر مطابقة.</p>
            <a class="btn btn-sm btn-primary" asp-action="Create">فتح تذكرة جديدة</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>الرقم</th>
                        <th>الموضوع</th>
                        <th>الأصل</th>
                        <th>الأولوية</th>
                        <th>الحالة</th>
                        <th>الفني</th>
                        <th>المُبلِّغ</th>
                        <th class="text-nowrap">موعد الحل</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.Items)
                {
                    <tr class="@(t.IsSlaBreached && t.ResolvedAt == null ? "table-danger" : "")">
                        <td>
                            <a class="mono fw-semibold" asp-action="Details" asp-route-id="@t.Id">@t.TicketNumber</a>
                        </td>
                        <td>
                            <div class="fw-semibold">@t.Title</div>
                            <small class="text-muted">@DisplayHelper.Name(t.Type) · @DisplayHelper.Relative(t.ReportedAt)</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(t.AssetTag))
                            {
                                <div>
                                    <a class="mono" asp-controller="Assets" asp-action="ByTag"
                                       asp-route-tag="@t.AssetTag">@t.AssetTag</a>
                                </div>
                                <small class="text-muted">@t.AssetName</small>
                            }
                            else { <small class="text-muted">—</small> }
                        </td>
                        <td>@Html.Raw(DisplayHelper.Chip(t.Priority))</td>
                        <td>@Html.Raw(DisplayHelper.Chip(t.Status))</td>
                        <td>
                            @if (!string.IsNullOrEmpty(t.TechnicianName))
                            {
                                <small><i class="bi bi-person-gear text-primary"></i> @t.TechnicianName</small>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">غير مُكلَّفة</span>
                            }
                        </td>
                        <td><small class="text-muted">@(t.RequesterName ?? "—")</small></td>
                        <td class="text-nowrap">
                            @if (t.ResolvedAt.HasValue)
                            {
                                <small class="text-success"><i class="bi bi-check2-circle"></i> @DisplayHelper.Date(t.ResolvedAt)</small>
                            }
                            else if (t.ResolutionDueAt.HasValue)
                            {
                                var hrs = t.HoursRemaining ?? 0;
                                var cls = hrs < 0 ? "text-danger fw-bold" : (hrs < 4 ? "text-warning fw-semibold" : "text-muted");
                                <small class="@cls">
                                    @DisplayHelper.Date(t.ResolutionDueAt)
                                    <br />
                                    @if (hrs < 0)
                                    {
                                        <span>متأخرة @Math.Abs(Math.Round(hrs)) ساعة</span>
                                    }
                                    else
                                    {
                                        <span>باقي @Math.Round(hrs) ساعة</span>
                                    }
                                </small>
                            }
                            else { <small class="text-muted">—</small> }
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@t.Id"
                               title="التفاصيل"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" />
