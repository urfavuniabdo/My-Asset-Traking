@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<header class="page-head">
    <div>
        <h1><i class="bi bi-key"></i> تغيير كلمة المرور</h1>
        <p class="page-sub">اختر كلمة مرور قوية لا تستخدمها في مواقع أخرى</p>
    </div>
</header>

<div class="row">
    <div class="col-lg-6">
        <section class="card">
            <div class="card-body">
                <form method="post" asp-action="ChangePassword" data-once>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" dir="ltr"
                               autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" dir="ltr"
                               autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text">
                            ٨ أحرف على الأقل، وتشمل حرفاً كبيراً وحرفاً صغيراً ورقماً ورمزاً خاصاً.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" dir="ltr"
                               autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2"></i> حفظ كلمة المرور
                        </button>
                        <a href="/Account/Profile" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>
