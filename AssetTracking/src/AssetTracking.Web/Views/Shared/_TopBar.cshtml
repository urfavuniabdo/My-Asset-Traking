@{
    /* الشريط العلوي الموحد + قائمة الموبايل — يُكتب مرة واحدة ويُستدعى في كل الصفحات.
       يقرأ ViewData["SearchQ"] (اختياري) لملء حقل البحث.
       يعتمد على wwwroot/css/sidenav.css قسم الموبايل (.mnav). */
    var fullName = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "";
    var roleLabel = User.IsInRole(Roles.Admin) ? "مدير النظام"
        : User.IsInRole(Roles.CompanyManager) ? "مدير شركة"
        : User.IsInRole(Roles.Technician) ? "فني دعم" : "موظف";
    var roleKey = User.IsInRole(Roles.Admin) ? "role.admin"
        : User.IsInRole(Roles.CompanyManager) ? "role.manager"
        : User.IsInRole(Roles.Technician) ? "role.tech" : "role.employee";
    var searchQ = ViewData["SearchQ"] as string;
}
<!-- تطبيق الثيم قبل عرض الصفحة لمنع الوميض -->
<script>
    (function(){
        var t = localStorage.getItem('ats_theme');
        if (t === 'dark') {
            document.documentElement.setAttribute('data-theme','dark');
            document.documentElement.classList.add('dark');
        }
    })();
</script>
<!-- ══ الشريط العلوي ══ -->
<header class="ats-topbar bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.06)] h-[66px] shrink-0 flex items-center px-3 md:px-5 gap-2 md:gap-4 relative z-30">
    <button type="button" id="nav-burger" aria-label="فتح القائمة"
            class="md:hidden w-10 h-10 rounded-xl hover:bg-slate-100 active:bg-slate-200 flex items-center justify-center text-slate-600 shrink-0 transition">
        <i class="fas fa-bars text-[18px]"></i>
    </button>
    <!-- اللوجو جمب التلت شرط — يظهر في الموبايل والديسكتوب. اسم التطبيق يرجع جنبه على الشاشات الكبيرة (md+). -->
    <a href="/" aria-label="الصفحة الرئيسية" class="topbar-logo shrink-0 flex items-center justify-center gap-2 md:gap-2.5">
        <img src="~/img/login-logo.png" asp-append-version="true" alt="Asset Tracking"
             class="h-10 w-10 md:h-11 md:w-11 object-contain">
        <span class="topbar-title hidden md:block text-[15px] font-extrabold text-slate-800 leading-tight whitespace-nowrap"
              data-i18n="brand.name">نظام إدارة الأصول</span>
    </a>
    <form action="/Assets" method="get" role="search" class="flex-1 hidden md:block max-w-[540px] mx-auto relative">
        <input name="q" value="@searchQ" data-i18n="search.placeholder"
               placeholder="ابحث عن أصل أو موقع أو رقم..."
               class="w-full h-11 bg-[#f1f5fa] rounded-full px-12 text-[13.5px] text-slate-700 placeholder-slate-400 outline-none focus:ring-2 focus:ring-brand-400/50 transition">
        <i class="fas fa-magnifying-glass absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-[14px]"></i>
    </form>
    <div class="topbar-actions flex items-center gap-2 md:gap-3 shrink-0">
        <!-- ══ جرس الإشعارات — دروب‑داون مستقل عن Bootstrap يعمل في كل الصفحات ══ -->
        <div class="relative" id="notif-wrap">
            <button type="button" id="notif-bell" data-i18n-title="topbar.notifications" title="الإشعارات"
                    class="relative w-10 h-10 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-500 transition">
                <i class="far fa-bell text-[17px]"></i>
                <span class="notif-dot hidden" id="notif-count">0</span>
            </button>
            <div id="notif-panel" class="notif-panel hidden absolute top-[115%] z-50">
                <div class="notif-head">
                    <strong data-i18n="topbar.notifications">الإشعارات</strong>
                    <button class="btn btn-sm btn-link" id="notif-mark-all" type="button" data-i18n="notif.mark_all">
                        تحديد الكل كمقروء
                    </button>
                </div>
                <div id="notif-list" class="notif-list">
                    <div class="notif-empty">
                        <i class="far fa-hourglass"></i> <span data-i18n="notif.loading">جارٍ التحميل…</span>
                    </div>
                </div>
                <a class="notif-foot" href="/Notifications" data-i18n="notif.view_all">عرض كل الإشعارات</a>
            </div>
        </div>
        <div class="relative">
            <button type="button" id="user-btn" class="flex items-center gap-2.5 rounded-full hover:bg-slate-100 pl-2 pr-1 py-1 transition">
                <span class="hidden sm:block text-left leading-tight">
                    <span class="block text-[13.5px] font-bold text-slate-800 max-w-[140px] truncate">@fullName</span>
                    <span class="block text-[11px] text-slate-400" data-i18n="@roleKey">@roleLabel</span>
                </span>
                <span class="w-10 h-10 rounded-full bg-[#e7f0fe] text-brand-600 flex items-center justify-center"><i class="fas fa-user text-[15px]"></i></span>
                <i class="fas fa-chevron-down text-[11px] text-slate-400"></i>
            </button>
            <div id="user-menu" class="hidden absolute top-[110%] w-56 bg-white rounded-xl shadow-xl border border-slate-100 py-1.5 z-50">
                <a href="/Account/Profile" class="flex items-center gap-2.5 px-4 py-2 text-[13px] text-slate-600 hover:bg-slate-50">
                    <i class="fas fa-user w-4 text-slate-400"></i>
                    <span data-i18n="user.profile">الملف الشخصي</span>
                </a>
                <a href="/Account/ChangePassword" class="flex items-center gap-2.5 px-4 py-2 text-[13px] text-slate-600 hover:bg-slate-50">
                    <i class="fas fa-key w-4 text-slate-400"></i>
                    <span data-i18n="user.change_pass">تغيير كلمة المرور</span>
                </a>
                <hr class="my-1 border-slate-100">
                <!-- ── شريط التفضيلات: زرّا اللغة والثيم — نفس شكل كارت الدخول (دائري، كل واحد في زاوية) ── -->
                <div class="pref-bar">
                    <button type="button" id="ats-lang-btn" class="pref-btn ats-lang-toggle login-pref-btn" title="Switch to English">
                        <span class="ats-lang-text">EN</span>
                    </button>
                    <button type="button" id="ats-theme-btn" class="pref-btn ats-theme-toggle login-pref-btn" title="الوضع الداكن">
                        <i class="fas fa-moon"></i>
                    </button>
                </div>
                <hr class="my-1 border-slate-100">
                <form method="post" action="/Account/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full flex items-center gap-2.5 px-4 py-2 text-[13px] text-red-500 hover:bg-red-50">
                        <i class="fas fa-right-from-bracket w-4"></i>
                        <span data-i18n="user.logout">تسجيل الخروج</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>

<!-- ══ قائمة الموبايل — نفس القائمة الجانبية داخل درج منسدل ══ -->
<div id="mnav" class="mnav fixed inset-0 z-50 hidden" role="dialog" aria-label="قائمة التنقل">
    <div id="mnav-backdrop" class="absolute inset-0 bg-slate-900/40"></div>
    <div class="mnav-panel absolute top-3 bottom-3 w-[248px] max-w-[80vw]">
        @await Html.PartialAsync("_SideNav")
    </div>
</div>

<script src="~/js/theme.js" asp-append-version="true"></script>
<script>
    (function () {
        var burger = document.getElementById('nav-burger'), mnav = document.getElementById('mnav');
        if (burger && mnav) {
            burger.addEventListener('click', function () { mnav.classList.remove('hidden'); });
            document.getElementById('mnav-backdrop').addEventListener('click', function () { mnav.classList.add('hidden'); });
        }
        var btn = document.getElementById('user-btn'), menu = document.getElementById('user-menu');
        if (btn && menu) {
            btn.addEventListener('click', function (e) { e.stopPropagation(); menu.classList.toggle('hidden'); });
            document.addEventListener('click', function () { menu.classList.add('hidden'); });
        }
        // دروب‑داون الإشعارات — تفتح/تُغلق نفسها، وتُغلق عند الضغط خارجها
        var notifBtn = document.getElementById('notif-bell'), notifPanel = document.getElementById('notif-panel');
        if (notifBtn && notifPanel) {
            notifBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                if (menu) menu.classList.add('hidden');
                notifPanel.classList.toggle('hidden');
            });
            notifPanel.addEventListener('click', function (e) { e.stopPropagation(); });
            document.addEventListener('click', function () { notifPanel.classList.add('hidden'); });
        }
    })();
</script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script src="~/js/notifications.js" asp-append-version="true"></script>
