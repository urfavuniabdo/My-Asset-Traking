@using System.Security.Claims
@using AssetTracking.Web.Configuration
@using AssetTracking.Web.Filters
@inject Microsoft.Extensions.Options.IOptions<FeatureFlags> FeatureOptions
@{
    /* القائمة الجانبية الموحدة — تُكتب مرة واحدة وتُستدعى في كل الصفحات.
       الصفحة الحالية تُحدَّد عبر ViewData["NavActive"] بقيمة:
       home / assets / warehouses / custody / tickets / reports / admin */
    var F = FeatureOptions.Value;
    var active = ViewData["NavActive"] as string ?? "";
    bool isEmp = User.IsInRole(Roles.Employee);

    // الصلاحيات تُقرأ من السياسة المسجّلة نفسها التي يفحصها [Authorize] (NavPolicyFilter)،
    // لا من قائمة أدوار مكتوبة يدوياً في القالب — اليدوية انفصلت فعلاً:
    // كان «/Warehouses» يظهر للفنّي بينما الـ Controller مقفل بـ ManagerOrAdmin.
    var policyAccess = ViewData[ViewDataKeys.PolicyAccess] as Dictionary<string, bool>;
    bool allowed(string policy) =>
        policyAccess != null && policyAccess.TryGetValue(policy, out var ok) && ok;
    bool mgr = allowed(Policies.ManagerOrAdmin);

    var items = new List<(string Href, string Key, string Label, string I18nKey, string Icon, bool Show, bool Act)> {
        ("/", "home", "الرئيسية", "nav.home", "fa-house", true, active == "home"),
        // سياسة القراءة المقرَّرة (B4): الموظف يقرأ أصول شركته ويُمنع من شركات أخرى —
        // يُنفِّذها الخادم (فلتر عزل الشركة + TenantGuard.ReadableBy)، لا هذه السمة.
        // إخفاء الرابط هنا قرار واجهة فقط: مسارات /Assets و/Assets/Details تعمل له فعلياً.
        ("/Assets", "assets", "الأصول", "nav.assets", "fa-cubes", !isEmp, active == "assets"),
        ("/Warehouses", "warehouses", "المخزون", "nav.warehouses", "fa-warehouse", mgr, active == "warehouses"),
        (isEmp ? "/Custody/MyCustody" : "/Custody", "custody", "العهد", "nav.custody", "fa-right-left", true, active == "custody"),
        ("/Tickets", "tickets", "الدعم الفني", "nav.tickets", "fa-headset", F.Tickets, active == "tickets"),
        ("/Reports", "reports", "التقارير", "nav.reports", "fa-chart-line", F.Reports && mgr, active == "reports"),
        ("/Admin", "admin", "الإعدادات", "nav.admin", "fa-gear", mgr, active == "admin"),
    };
}
<nav class="msn" aria-label="القائمة الرئيسية">
    <!-- الشعار + اسم المشروع — انتقلوا من الشريط العلوي إلى هنا (يظهرون في القائمة الجانبية ودرج الموبايل) -->
    <a href="/" class="msn-brand">
        <img src="~/img/login-logo.png" asp-append-version="true" alt="Asset Tracking">
        <span data-i18n="brand.name">نظام إدارة الأصول</span>
    </a>
    <ul class="msn-list">
        @foreach (var it in items.Where(i => i.Show))
        {
            var cls = it.Act ? (it.Key == "home" ? "msn-item msn-solid" : "msn-item msn-active") : "msn-item";
            <li>
                <a href="@it.Href" class="@cls">
                    <i class="fas @it.Icon"></i><span data-i18n="@it.I18nKey">@it.Label</span>
                </a>
            </li>
        }
    </ul>
    <div class="msn-foot" data-i18n="nav.footer">نحو إدارة أذكى للأصول</div>
</nav>
