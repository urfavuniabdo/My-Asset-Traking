@using System.Security.Claims
@{
    var me = User;
    bool isAuth = me?.Identity?.IsAuthenticated == true;
    bool isAdmin = isAuth && me!.IsInRole(Roles.Admin);
    bool isManager = isAuth && me!.IsInRole(Roles.CompanyManager);
    bool isTech = isAuth && me!.IsInRole(Roles.Technician);
    bool isEmployee = isAuth && !isAdmin && !isManager && !isTech;
    string fullName = me?.FindFirst(AppClaims.FullName)?.Value
                      ?? me?.Identity?.Name ?? "";
    string roleLabel = isAdmin ? "مدير النظام" : isManager ? "مدير شركة" : isTech ? "فني دعم" : "موظف";
    string ctrl = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    string act = (string?)ViewContext.RouteData.Values["action"] ?? "";
    Func<string, string> nav = c => ctrl.Equals(c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "لوحة المعلومات") — نظام إدارة الأصول</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isAuth ? "" : "auth-page")">

@if (isAuth)
{
    <!-- ══ الشريط العلوي ══════════════════════════════ -->
    <header class="topbar">
        <button class="btn btn-link topbar-toggle d-lg-none" type="button" id="sidebar-toggle"
                aria-label="القائمة">
            <i class="bi bi-list"></i>
        </button>

        <a class="topbar-brand" href="/">
            <i class="bi bi-boxes"></i>
            <span>نظام إدارة الأصول</span>
        </a>

        <div class="topbar-spacer"></div>

        <!-- البحث السريع بكود الأصل -->
        <form class="topbar-search d-none d-md-flex" action="/Assets" method="get" role="search">
            <i class="bi bi-search"></i>
            <input type="search" name="q" class="form-control" placeholder="ابحث بكود الأصل أو الاسم…"
                   value="@(ViewContext.HttpContext.Request.Query["q"])" aria-label="بحث" />
        </form>

        <!-- ماسح QR -->
        <a href="/Assets/Scan" class="topbar-icon" title="مسح QR">
            <i class="bi bi-qr-code-scan"></i>
        </a>

        <!-- جرس الإشعارات -->
        <div class="dropdown topbar-icon-wrap">
            <button class="topbar-icon" type="button" id="notif-bell" data-bs-toggle="dropdown"
                    data-bs-auto-close="outside" aria-expanded="false" title="الإشعارات">
                <i class="bi bi-bell"></i>
                <span class="notif-dot d-none" id="notif-count">0</span>
            </button>
            <div class="dropdown-menu dropdown-menu-start notif-panel" aria-labelledby="notif-bell">
                <div class="notif-head">
                    <strong>الإشعارات</strong>
                    <button class="btn btn-sm btn-link" id="notif-mark-all" type="button">
                        تحديد الكل كمقروء
                    </button>
                </div>
                <div id="notif-list" class="notif-list">
                    <div class="notif-empty">
                        <i class="bi bi-hourglass"></i> جارٍ التحميل…
                    </div>
                </div>
                <a class="notif-foot" href="/Notifications">عرض كل الإشعارات</a>
            </div>
        </div>

        <!-- قائمة المستخدم -->
        <div class="dropdown topbar-icon-wrap">
            <button class="topbar-user" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar">@(string.IsNullOrEmpty(fullName) ? "؟" : fullName.Trim()[0].ToString())</span>
                <span class="d-none d-md-inline user-meta">
                    <span class="user-name">@fullName</span>
                    <span class="user-role">@roleLabel</span>
                </span>
                <i class="bi bi-chevron-down d-none d-md-inline"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-start">
                <li><a class="dropdown-item" href="/Account/Profile">
                    <i class="bi bi-person"></i> الملف الشخصي</a></li>
                <li><a class="dropdown-item" href="/Account/ChangePassword">
                    <i class="bi bi-key"></i> تغيير كلمة المرور</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form method="post" action="/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </header>

    <!-- ══ القائمة الجانبية ═══════════════════════════ -->
    <nav class="sidebar" id="sidebar" aria-label="القائمة الرئيسية">
        <ul class="side-nav">
            <li>
                <a class="@nav("Home")" href="/">
                    <i class="bi bi-speedometer2"></i><span>لوحة المعلومات</span>
                </a>
            </li>

            <li class="side-sep">الأصول والعهد</li>

            @if (!isEmployee)
            {
                <li>
                    <a class="@nav("Assets")" href="/Assets">
                        <i class="bi bi-boxes"></i><span>الأصول</span>
                    </a>
                </li>
            }
            <li>
                <a class="@(ctrl == "Custody" && act == "MyCustody" ? "active" : "")" href="/Custody/MyCustody">
                    <i class="bi bi-person-badge"></i><span>عهدي</span>
                </a>
            </li>
            @if (!isEmployee)
            {
                <li>
                    <a class="@(ctrl == "Custody" && act != "MyCustody" ? "active" : "")" href="/Custody">
                        <i class="bi bi-arrow-left-right"></i><span>إدارة العهد</span>
                    </a>
                </li>
            }

            <li class="side-sep">الدعم الفني</li>

            <li>
                <a class="@nav("Tickets")" href="/Tickets">
                    <i class="bi bi-ticket-detailed"></i><span>التذاكر</span>
                </a>
            </li>
            @if (isTech || isManager || isAdmin)
            {
                <li>
                    <a class="@nav("MaintenanceSchedules")" href="/MaintenanceSchedules">
                        <i class="bi bi-calendar-check"></i><span>الصيانة الوقائية</span>
                    </a>
                </li>
            }

            @if (isManager || isAdmin)
            {
                <li class="side-sep">الجرد والتقارير</li>
                <li>
                    <a class="@nav("InventoryAudits")" href="/InventoryAudits">
                        <i class="bi bi-clipboard-check"></i><span>الجرد</span>
                    </a>
                </li>
                <li>
                    <a class="@nav("Reports")" href="/Reports">
                        <i class="bi bi-graph-up"></i><span>التقارير</span>
                    </a>
                </li>
            }

            @if (isManager || isAdmin)
            {
                <li class="side-sep">الإعدادات</li>
                <li>
                    <a class="@(ctrl == "Admin" ? "active" : "")" href="/Admin">
                        <i class="bi bi-gear"></i><span>الإدارة</span>
                    </a>
                </li>
            }
            @if (isAdmin)
            {
                <li>
                    <a href="/jobs" target="_blank">
                        <i class="bi bi-cpu"></i><span>المهام المجدولة</span>
                        <i class="bi bi-box-arrow-up-left small ms-auto"></i>
                    </a>
                </li>
            }
        </ul>

        <div class="side-foot">
            <div class="side-foot-role">
                <i class="bi bi-shield-check"></i> @roleLabel
            </div>
        </div>
    </nav>

    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- ══ المحتوى ════════════════════════════════════ -->
    <main class="content">
        @if (TempData["ToastSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["ToastSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
            </div>
        }
        @if (TempData["ToastError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["ToastError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
            </div>
        }
        @if (TempData["ToastInfo"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle"></i> @TempData["ToastInfo"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
            </div>
        }

        @RenderBody()
    </main>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (isAuth)
{
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
