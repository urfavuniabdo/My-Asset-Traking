@using System.Security.Claims
@{
    // مفاتيح تشغيل الوحدات — الوحدات المُطفأة تُخفى من القائمة وتُحجب مساراتها
    var F = FeatureOptions.Value;
    var me = User;
    bool isAuth = me?.Identity?.IsAuthenticated == true;
    bool isAdmin = isAuth && me!.IsInRole(Roles.Admin);
    bool isManager = isAuth && me!.IsInRole(Roles.CompanyManager);
    bool isTech = isAuth && me!.IsInRole(Roles.Technician);
    bool isEmployee = isAuth && !isAdmin && !isManager && !isTech;
    string fullName = me?.FindFirst(AppClaims.FullName)?.Value
                      ?? me?.Identity?.Name ?? "";
    string roleLabel = isAdmin ? "مدير النظام" : isManager ? "مدير شركة" : isTech ? "فني دعم" : "موظف";
    string ctrl = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    ViewData["NavActive"] = ctrl switch { "Home" => "home", "Assets" => "assets", "Warehouses" => "warehouses", "Custody" => "custody", "Tickets" => "tickets", "Reports" => "reports", "Admin" => "admin", _ => "" };
    string act = (string?)ViewContext.RouteData.Values["action"] ?? "";
    Func<string, string> nav = c => ctrl.Equals(c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    ViewData["SearchQ"] = ViewContext.HttpContext.Request.Query["q"].ToString();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "لوحة المعلومات") — نظام إدارة الأصول</title>
    <link rel="icon" type="image/png" href="~/img/login-logo.png" asp-append-version="true">
    <!-- أيقونة التطبيق عند التثبيت من المتصفح (PWA) -->
    <link rel="manifest" href="~/manifest.json">
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png">
    <meta name="theme-color" content="#2563eb">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.4.0/css/all.min.css" rel="stylesheet">
    @if (isAuth)
    {
        <!-- Tailwind — يُستخدم فقط لتوحيد شكل الشريط/القائمة الجانبية.
             preflight معطّل حتى لا يتعارض مع إعادة تصفير Bootstrap في صفحات الـ Layout. -->
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                darkMode: ['selector', '[data-theme="dark"]'],
                corePlugins: { preflight: false },
                theme: {
                    extend: {
                        fontFamily: { sans: ['Cairo', 'system-ui', 'sans-serif'] },
                        colors: {
                            brand: {
                                50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa',
                                500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a'
                            }
                        }
                    }
                }
            };
        </script>
    }
    <link href="~/css/sidenav.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <!-- تطبيق الثيم قبل عرض الصفحة لمنع الوميض -->
    <script>
        (function(){
            var t = localStorage.getItem('ats_theme');
            if (t === 'dark') {
                document.documentElement.setAttribute('data-theme','dark');
                document.documentElement.classList.add('dark');
            }
            var l = localStorage.getItem('ats_lang');
            if (l === 'en') {
                document.documentElement.setAttribute('lang', 'en');
                document.documentElement.setAttribute('dir', 'ltr');
            }
        })();
    </script>
</head>
<body class="@(isAuth ? "overflow-hidden" : "auth-page")">

@if (isAuth)
{
    <!-- ══ الهيكل الموحّد — نفس شريط/قائمة كل الصفحات الحديثة (_TopBar + _SideNav) ══ -->
    <div class="h-screen flex flex-col gap-3 p-3 relative z-10">
        @await Html.PartialAsync("_TopBar")

        <div class="flex-1 flex gap-3 min-h-0">
            @await Html.PartialAsync("_SideNav")

            <!-- ══ المحتوى ════════════════════════════════════ -->
            <main class="content flex-1 min-w-0 overflow-y-auto">
                @if (TempData["ToastSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle"></i> @TempData["ToastSuccess"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                    </div>
                }
                @if (TempData["ToastError"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> @TempData["ToastError"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                    </div>
                }
                @if (TempData["ToastInfo"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="bi bi-info-circle"></i> @TempData["ToastInfo"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@* theme.js + SignalR + notifications.js تُحمَّل من القطعة المشتركة _TopBar لتعمل بنفس اللوجيك في كل الصفحات *@
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
