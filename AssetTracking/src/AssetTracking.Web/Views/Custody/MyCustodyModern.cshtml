@model MyCustodyViewModel
@using System.Globalization
@using AssetTracking.Domain.Enums
@using AssetTracking.Web.Configuration
@inject Microsoft.Extensions.Options.IOptions<FeatureFlags> FeatureOptions
@{
    // صفحة عهدي الحديثة — لمدير النظام فقط (حتى إشعار آخر)
    Layout = null;
    ViewData["Title"] = "عهدي";
    var F = FeatureOptions.Value;
    var fullName = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "";
    var roleLabel = User.IsInRole(Roles.Admin) ? "مدير النظام"
        : User.IsInRole(Roles.CompanyManager) ? "مدير شركة"
        : User.IsInRole(Roles.Technician) ? "فني دعم" : "موظف";
    var ar = new CultureInfo("ar-EG");
    string D(DateTime d) => d.ToString("yyyy-MM-dd", ar);

    string CatIcon(string c) => c.Contains("لابتوب") || c.Contains("حاسوب") ? "fa-laptop"
        : c.Contains("طابع") ? "fa-print"
        : c.Contains("شاشة") ? "fa-desktop"
        : c.Contains("عرض") || c.Contains("بروجكتور") || c.Contains("بروجكتر") ? "fa-tv"
        : c.Contains("شبك") || c.Contains("راوتر") || c.Contains("مودم") ? "fa-wifi"
        : c.Contains("هاتف") || c.Contains("موبايل") ? "fa-mobile-screen"
        : c.Contains("كامير") ? "fa-camera"
        : c.Contains("حساس") ? "fa-tower-broadcast"
        : c.Contains("تحكم") ? "fa-microchip"
        : c.Contains("معدات") || c.Contains("محرّك") || c.Contains("موتور") || c.Contains("مكين") ? "fa-gears"
        : "fa-box";

    string ActLabel(CustodyAction a) => a switch
    {
        CustodyAction.Assign => "تسليم",
        CustodyAction.Transfer => "نقل",
        _ => "استرجاع"
    };
    string ActCls(CustodyAction a) => a switch
    {
        CustodyAction.Assign => "bg-emerald-50 text-emerald-600",
        CustodyAction.Transfer => "bg-violet-50 text-violet-600",
        _ => "bg-blue-50 text-blue-600"
    };
    var countReceive = Model.Pending.Count(p => p.Action == CustodyAction.Assign);
    var countSend = Model.Pending.Count(p => p.Action == CustodyAction.Return);
    var firstAssetId = Model.MyAssets.FirstOrDefault()?.Id;
    var navItems = new List<(string Href, string Label, string Icon, bool Show, bool Active)> {
        ("/", "الرئيسية", "fa-house", true, false),
        ("/Assets", "الأصول", "fa-cubes", true, false),
        ("/InventoryAudits", "المخزون", "fa-boxes-stacked", F.InventoryAudits, false),
        ("/Custody", "العهد", "fa-right-left", true, true),
        ("/Tickets", "الدعم الفني", "fa-headset", F.Tickets, false),
        ("/Reports", "التقارير", "fa-chart-line", F.Reports, false),
        ("/Admin", "الإعدادات", "fa-gear", true, false)
    };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — نظام إدارة الأصول</title>
    <link rel="icon" type="image/png" href="~/img/login-logo.png" asp-append-version="true">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Cairo', 'system-ui', 'sans-serif'] },
                    colors: {
                        brand: {
                            50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa',
                            500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
    </style>
</head>
<body class="bg-[#e9f1fc] font-sans text-slate-800 antialiased overflow-hidden">
    <!-- خلفية زخرفية -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" style="background:linear-gradient(180deg,#e7f0fc 0%,#edf4fd 50%,#f7fbfe 100%)">
        <svg class="absolute bottom-0 left-0 w-[600px] h-[310px]" viewBox="0 0 600 300" preserveAspectRatio="none">
            <path d="M0 105 C 110 25, 215 165, 335 105 C 435 55, 525 70, 600 130 L600 300 L0 300 Z" fill="#ddecfd"/>
            <path d="M0 145 C 90 70, 195 195, 325 140 C 445 92, 535 120, 600 195 L600 300 L0 300 Z" fill="#c6ddfb" opacity="0.8"/>
            <path d="M0 215 C 130 150, 265 245, 405 200 C 505 168, 565 205, 600 235 L600 300 L0 300 Z" fill="#b6d8fd" opacity="0.65"/>
        </svg>
        <svg class="absolute bottom-0 left-0 w-full h-[64px]" viewBox="0 0 1600 64" preserveAspectRatio="none">
            <path d="M0 38 C 300 0, 700 58, 1000 28 C 1250 6, 1450 30, 1600 18 L1600 64 L0 64 Z" fill="#e2f1fd" opacity="0.9"/>
        </svg>
        <div class="absolute bottom-[-50px] right-[-20px] w-[320px] h-[320px]">
            <div class="absolute inset-0 rounded-full" style="background:radial-gradient(circle at 35% 30%, #f2f8fe 0%, #e4eefc 55%, #d9e9fb 100%)"></div>
            <svg class="absolute top-8 right-10 w-[150px] rotate-[-8deg]" viewBox="0 0 200 220">
                <defs>
                    <linearGradient id="cubeTop" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f8fbff"/><stop offset="1" stop-color="#e3effd"/></linearGradient>
                    <linearGradient id="cubeLeft" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#dcebfd"/><stop offset="1" stop-color="#c9def9"/></linearGradient>
                    <linearGradient id="cubeRight" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#cfe2fb"/><stop offset="1" stop-color="#e1effd"/></linearGradient>
                </defs>
                <polygon points="100,8 188,56 100,104 12,56" fill="url(#cubeTop)"/>
                <polygon points="12,56 100,104 100,212 12,164" fill="url(#cubeLeft)"/>
                <polygon points="188,56 100,104 100,212 188,164" fill="url(#cubeRight)"/>
            </svg>
        </div>
    </div>

    <div class="h-screen flex flex-col gap-3 p-3 relative z-10">
        <!-- ══ الشريط العلوي ══ -->
        <header class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.06)] h-[66px] shrink-0 flex items-center px-5 gap-4 relative z-30">
            <a href="/" class="flex items-center gap-2.5 shrink-0">
                <img src="~/img/login-logo.png" asp-append-version="true" alt="Asset Tracking" class="h-11 w-11 object-contain drop-shadow-sm">
                <span class="text-[19px] font-extrabold text-slate-800">نظام إدارة الأصول</span>
            </a>
            <form action="/Assets" method="get" role="search" class="hidden md:block flex-1 max-w-[540px] mx-auto relative">
                <input name="q" placeholder="ابحث عن أصل أو موقع أو رقم..."
                       class="w-full h-11 bg-[#f1f5fa] rounded-full px-12 text-[13.5px] text-slate-700 placeholder-slate-400 outline-none focus:ring-2 focus:ring-brand-400/50 transition">
                <i class="fas fa-magnifying-glass absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-[14px]"></i>
            </form>
            <div class="flex items-center gap-3 shrink-0 ms-auto">
                <a href="/Notifications" title="الإشعارات" class="relative w-10 h-10 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-500 transition">
                    <i class="far fa-bell text-[17px]"></i>
                    <span class="absolute top-2 right-2.5 w-2 h-2 rounded-full bg-red-500 ring-2 ring-white"></span>
                </a>
                <div class="relative">
                    <button type="button" id="user-btn" class="flex items-center gap-2.5 rounded-full hover:bg-slate-100 pl-2 pr-1 py-1 transition">
                        <i class="fas fa-chevron-down text-[11px] text-slate-400"></i>
                        <span class="text-left leading-tight">
                            <span class="block text-[13.5px] font-bold text-slate-800">@fullName</span>
                            <span class="block text-[11px] text-slate-400">@roleLabel</span>
                        </span>
                        <span class="w-10 h-10 rounded-full bg-[#e7f0fe] text-brand-600 flex items-center justify-center"><i class="fas fa-user text-[15px]"></i></span>
                    </button>
                    <div id="user-menu" class="hidden absolute left-0 top-[110%] w-52 bg-white rounded-xl shadow-xl border border-slate-100 py-1.5 z-50">
                        <a href="/Account/Profile" class="flex items-center gap-2.5 px-4 py-2 text-[13px] text-slate-600 hover:bg-slate-50"><i class="fas fa-user w-4 text-slate-400"></i> الملف الشخصي</a>
                        <a href="/Account/ChangePassword" class="flex items-center gap-2.5 px-4 py-2 text-[13px] text-slate-600 hover:bg-slate-50"><i class="fas fa-key w-4 text-slate-400"></i> تغيير كلمة المرور</a>
                        <hr class="my-1 border-slate-100">
                        <form method="post" action="/Account/Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full flex items-center gap-2.5 px-4 py-2 text-[13px] text-red-500 hover:bg-red-50"><i class="fas fa-right-from-bracket w-4"></i> تسجيل الخروج</button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 flex gap-3 min-h-0">
            <!-- ══ القائمة الجانبية ══ -->
            <nav class="w-[228px] shrink-0 bg-white/85 backdrop-blur-md rounded-3xl shadow-[0_2px_12px_rgba(30,90,180,0.06)] p-3.5 flex flex-col relative z-10">
                <ul class="flex flex-col gap-1">
                    @foreach (var n in navItems.Where(n => n.Show))
                    {
                        <li>
                            <a href="@n.Href"
                               class="@(n.Active ? "bg-[#e7f0fe] text-brand-700" : "text-slate-600 hover:bg-blue-50/70 hover:text-brand-700")
                                  flex items-center gap-3 rounded-xl px-4 h-[46px] text-[14.5px] font-bold transition">
                                <span class="@(n.Active ? "text-brand-600" : "text-brand-500")"><i class="fas @n.Icon text-[15px]"></i></span>
                                @n.Label
                            </a>
                        </li>
                    }
                </ul>
                <div class="mt-auto text-center text-[12px] text-slate-400 pb-2">نحو إدارة أذكى للأصول</div>
            </nav>

            <!-- ══ المحتوى ══ -->
            <main class="flex-1 min-w-0 overflow-y-auto pe-0.5">
                <!-- بار التبويبات -->
                <div class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-1.5 inline-flex gap-1 mb-3">
                    <a href="/Custody" class="h-10 px-7 rounded-xl text-slate-500 hover:bg-blue-50 hover:text-brand-600 text-[13.5px] font-bold flex items-center transition">
                        <i class="fas fa-right-left text-[12px] me-2"></i> إدارة العهد
                    </a>
                    <a href="/Custody/MyCustody" class="h-10 px-7 rounded-xl bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] text-white text-[13.5px] font-bold flex items-center shadow-md shadow-blue-200">
                        <i class="fas fa-user text-[12px] me-2"></i> عهدي
                    </a>
                </div>

                <!-- العنوان -->
                <div class="flex items-center gap-3 mb-3 px-1">
                    <span class="w-11 h-11 rounded-xl bg-[#e7f0fe] text-brand-600 flex items-center justify-center"><i class="fas fa-hand-holding text-[17px]"></i></span>
                    <div>
                        <h1 class="text-[26px] font-extrabold text-slate-800 leading-tight">عهدي</h1>
                        <p class="text-[12.5px] text-slate-400 -mt-0.5">الأصول المسجلة بعهدتي ومتابعة سجل الاستلام والتسليم</p>
                    </div>
                </div>

                <!-- الإحصائيات + الأزرار -->
                <div class="flex items-stretch gap-3 mb-3">
                    <div class="flex-1 grid grid-cols-4 gap-3">
                        <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between">
                            <span class="text-right">
                                <span class="block text-[12.5px] text-slate-500 font-semibold">الأصول بعهدتي</span>
                                <span class="block text-[24px] font-extrabold text-slate-800 leading-tight">@Model.MyAssets.Count</span>
                            </span>
                            <span class="w-10 h-10 rounded-full bg-[#e7f0fe] flex items-center justify-center text-brand-500"><i class="fas fa-cube text-[14px]"></i></span>
                        </div>
                        <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between">
                            <span class="text-right">
                                <span class="block text-[12.5px] text-slate-500 font-semibold">طلبات الاستلام</span>
                                <span class="block text-[24px] font-extrabold text-slate-800 leading-tight">@countReceive</span>
                            </span>
                            <span class="w-10 h-10 rounded-full bg-[#e7f0fe] flex items-center justify-center text-brand-500"><i class="fas fa-download text-[14px]"></i></span>
                        </div>
                        <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between">
                            <span class="text-right">
                                <span class="block text-[12.5px] text-slate-500 font-semibold">طلبات التسليم</span>
                                <span class="block text-[24px] font-extrabold text-slate-800 leading-tight">@countSend</span>
                            </span>
                            <span class="w-10 h-10 rounded-full bg-[#e7f0fe] flex items-center justify-center text-brand-500"><i class="fas fa-paper-plane text-[14px]"></i></span>
                        </div>
                        <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between">
                            <span class="text-right">
                                <span class="block text-[12.5px] text-slate-500 font-semibold">إجمالي قيمة العهدة</span>
                                <span class="block text-[24px] font-extrabold text-slate-800 leading-tight">@Model.TotalValue.ToString("N0") <span class="text-[12px] font-bold text-slate-400">ج.م</span></span>
                            </span>
                            <span class="w-10 h-10 rounded-full bg-[#e7f0fe] flex items-center justify-center text-brand-500"><i class="fas fa-coins text-[14px]"></i></span>
                        </div>
                    </div>
                    <div class="w-[380px] shrink-0 bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-3 flex items-center gap-2">
                        <a href="/Custody/Assign" class="flex-1 h-11 bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] hover:from-[#2f78ef] hover:to-[#1745c9] rounded-xl flex items-center justify-center gap-2 text-[13px] font-bold text-white shadow-md shadow-blue-200 transition">
                            <i class="fas fa-plus text-[12px]"></i> طلب استلام أصل
                        </a>
                        @if (firstAssetId != null)
                        {
                            <a href="/Custody/Return?assetId=@firstAssetId" class="flex-1 h-11 bg-white border border-slate-200 hover:border-brand-300 hover:text-brand-700 rounded-xl flex items-center justify-center gap-2 text-[13px] font-bold text-slate-600 transition">
                                <i class="fas fa-right-left text-brand-500 text-[12px]"></i> طلب تسليم أصل
                            </a>
                        }
                        <a href="/Assets/Scan" class="flex-1 h-11 bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] hover:from-[#2f78ef] hover:to-[#1745c9] rounded-xl flex items-center justify-center gap-2 text-[13px] font-bold text-white shadow-md shadow-blue-200 transition">
                            <i class="fas fa-qrcode text-[12px]"></i> مسح QR
                        </a>
                    </div>
                </div>

                <!-- الأصول المسجلة بعهدتي -->
                <div class="bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-4 mb-3">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-[15px] font-extrabold text-slate-800"><i class="fas fa-cube text-brand-500 text-[13px]"></i> الأصول المسجلة بعهدتي</h3>
                        <a href="/Assets" class="text-[11.5px] text-slate-400 hover:text-brand-600 transition">عرض الكل <i class="fas fa-chevron-left text-[9px]"></i></a>
                    </div>
                    @if (Model.MyAssets.Count == 0)
                    {
                        <div class="text-center py-8">
                            <span class="w-24 h-24 mx-auto rounded-full bg-[#e9f1fc] flex items-center justify-center text-brand-300 mb-3"><i class="fas fa-box-open text-[34px]"></i></span>
                            <p class="text-[16px] font-extrabold text-slate-700">لا توجد أصول مسجلة بعهدتي حاليًا</p>
                            <p class="text-[12.5px] text-slate-400 mt-1 mb-4">عند تخصيص أصل لك ستظهر هنا مع تفاصيله وحالته وموعد إرجاعه إن وجد</p>
                            <a href="/Assets" class="inline-flex items-center gap-2 h-11 px-6 bg-gradient-to-b from-[#3b82f6] to-[#1d4ed8] hover:from-[#2f78ef] hover:to-[#1745c9] rounded-xl text-[13px] font-bold text-white shadow-md shadow-blue-200 transition">
                                <i class="fas fa-cube text-[12px]"></i> استعراض الأصول المتاحة
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-[minmax(180px,1.4fr)_110px_minmax(110px,1fr)_110px_100px] items-center px-4 py-2 text-[11.5px] font-bold text-slate-400 bg-[#f6f9fe] rounded-lg mb-1">
                            <span>اسم الأصل</span>
                            <span>الكود</span>
                            <span>التصنيف</span>
                            <span>القيمة</span>
                            <span class="text-left">إجراء</span>
                        </div>
                        @foreach (var a in Model.MyAssets)
                        {
                            <div class="grid grid-cols-[minmax(180px,1.4fr)_110px_minmax(110px,1fr)_110px_100px] items-center px-4 py-2.5 border-b border-slate-50 last:border-0 hover:bg-blue-50/30 rounded-lg transition">
                                <span class="flex items-center gap-2.5 min-w-0">
                                    <span class="w-9 h-9 rounded-lg bg-[#e7f0fe] text-brand-600 flex items-center justify-center shrink-0"><i class="fas @(CatIcon(a.CategoryName ?? "")) text-[13px]"></i></span>
                                    <span class="min-w-0">
                                        <span class="block text-[13px] font-bold text-slate-800 truncate">@a.NameAr</span>
                                        @if (!string.IsNullOrEmpty(a.Brand))
                                        {
                                            <span class="block text-[10.5px] text-slate-400 truncate">@a.Brand @a.Model</span>
                                        }
                                    </span>
                                </span>
                                <span><a href="/Assets/Details/@a.Id" class="text-[12px] font-extrabold text-brand-600 hover:underline" dir="ltr">@a.AssetTag</a></span>
                                <span class="text-[12px] text-slate-500 truncate">@a.CategoryName</span>
                                <span class="text-[12px] font-bold text-slate-600">@a.PurchaseValue?.ToString("N0") ج.م</span>
                                <span class="text-left">
                                    <a href="/Custody/Return?assetId=@a.Id" class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg border border-red-200 text-red-500 hover:bg-red-50 text-[11.5px] font-bold transition">
                                        <i class="fas fa-right-left text-[10px]"></i> تسليم أصل
                                    </a>
                                </span>
                            </div>
                        }
                    }
                </div>

                <!-- السجل + تحتاج أصل للعمل -->
                <div class="flex gap-3 items-start">
                    <div class="flex-1 min-w-0 bg-white rounded-2xl shadow-[0_2px_12px_rgba(30,90,180,0.05)] p-4">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="text-[15px] font-extrabold text-slate-800"><i class="far fa-clock text-brand-500 text-[14px]"></i> سجل حركات العهدة</h3>
                        </div>
                        @if (Model.History.Count == 0)
                        {
                            <div class="text-center py-6">
                                <span class="w-16 h-16 mx-auto rounded-full bg-[#e9f1fc] flex items-center justify-center text-brand-300 mb-2"><i class="far fa-clock text-[24px]"></i></span>
                                <p class="text-[12.5px] text-slate-400">ستظهر هنا عمليات الاستلام والتسليم والموافقات</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var h in Model.History.Take(6))
                            {
                                <div class="flex items-center gap-3 px-3 py-2.5 border-b border-slate-50 last:border-0 hover:bg-blue-50/30 rounded-lg transition">
                                    <span class="inline-block text-[10.5px] font-bold rounded-full px-2.5 py-1 @ActCls(h.Action)">@ActLabel(h.Action)</span>
                                    <span class="flex-1 min-w-0">
                                        <span class="block text-[12.5px] font-bold text-slate-700 truncate">@h.AssetName</span>
                                        <span class="block text-[10.5px] text-slate-400">من @(h.PreviousUserName ?? "المخزن") إلى @(h.NewUserName ?? "المخزن")</span>
                                    </span>
                                    <span class="text-[11px] text-slate-400" dir="ltr">@D(h.ActionDate)</span>
                                    <a href="/Assets/Details/@h.AssetId" class="text-[11.5px] font-bold text-brand-600 hover:underline" dir="ltr">@h.AssetTag</a>
                                </div>
                            }
                        }
                    </div>
                    <div class="w-[31%] shrink-0 bg-[#e8f1fe] rounded-2xl p-4">
                        <div class="flex items-center gap-3 mb-2">
                            <span class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center text-brand-500 text-[20px]"><i class="fas fa-clipboard-list"></i></span>
                            <h3 class="text-[15px] font-extrabold text-slate-800">تحتاج أصل للعمل؟</h3>
                        </div>
                        <p class="text-[12px] text-slate-500 leading-relaxed mb-3">أرسل طلب استلام وسيُحوَّل إلى المسؤول للموافقة عليه</p>
                        <a href="/Custody/Assign" class="inline-flex items-center gap-2 h-10 px-5 bg-white border border-brand-200 hover:border-brand-400 rounded-xl text-[12.5px] font-bold text-brand-600 transition">
                            <i class="fas fa-paper-plane text-[11px]"></i> إنشاء طلب
                        </a>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        var btn = document.getElementById('user-btn'), menu = document.getElementById('user-menu');
        btn?.addEventListener('click', function (e) { e.stopPropagation(); menu.classList.toggle('hidden'); });
        document.addEventListener('click', function () { menu?.classList.add('hidden'); });
    </script>
</body>
</html>
